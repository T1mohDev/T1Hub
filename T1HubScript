	local followButton = frame5:FindFirstChild("Follow")
	local orbitButton = frame5:FindFirstChild("Orbit")
	local trakButton = frame5:FindFirstChild("Trak")
	if not chosenLabel or not tpButton or not followButton or not orbitButton or not trakButton then
		return
	end
	local localPlayer = Players.LocalPlayer
	
	local selectedPlayer
	local followActive = false
	local orbitActive = false
	local trakActive = false
	local orbitAngle = 0
	local orbitHeight = 3
	local orbitRadius = 10
	local followDistance = 4
	local savedCollision = {}
	local playerConnections = {}
	
	local function getRoot(targetPlayer)
		local character = targetPlayer and targetPlayer.Character
		return character and character:FindFirstChild("HumanoidRootPart")
	end
	
	local function getLocalCharacter()
		local character = localPlayer.Character
		if not character then
			return nil, nil, nil
		end
		return character, character:FindFirstChildOfClass("Humanoid"), character:FindFirstChild("HumanoidRootPart")
	end
	
	local function setChosenText()
		chosenLabel.Text = selectedPlayer and ("Выбранный игрок: " .. selectedPlayer.Name) or "Выбранный игрок: нет"
	end
	
	local function restoreCollision()
		for part, canCollide in pairs(savedCollision) do
			if part and part.Parent then
				part.CanCollide = canCollide
			end
		end
		table.clear(savedCollision)
	end
	
	local function setOrbitCollision(enabled)
		local character = localPlayer.Character
		if not character then
			return
		end
		if enabled then
			table.clear(savedCollision)
			for _, object in character:GetDescendants() do
				if object:IsA("BasePart") then
					savedCollision[object] = object.CanCollide
					object.CanCollide = false
				end
			end
		else
			restoreCollision()
		end
	end
	
	local function stopModes()
		followActive = false
		orbitActive = false
		trakActive = false
		setOrbitCollision(false)
		followButton.Text = "Преследовать"
		orbitButton.Text = "Орбит"
		trakButton.Text = "Ртах"
	end
	
	local function validateSelection()
		if not selectedPlayer or selectedPlayer == localPlayer or not selectedPlayer.Parent then
			selectedPlayer = nil
			setChosenText()
			stopModes()
			return false
		end
		if not getRoot(selectedPlayer) then
			stopModes()
			return false
		end
		return true
	end
	
	local function selectPlayer(targetPlayer, targetButton)
		if selectedPlayer == targetPlayer then
			selectedPlayer = nil
		else
			stopModes()
			selectedPlayer = targetPlayer
		end
		setChosenText()
		for _, child in playerList:GetChildren() do
			if child:IsA("TextButton") then
				child.BackgroundColor3 = child == targetButton and Color3.fromRGB(120, 120, 120) or Color3.fromRGB(50, 50, 50)
			end
		end
	end
	
	local function createPlayerButton(targetPlayer)
		local targetButton = Instance.new("TextButton")
		targetButton.Name = "Player_" .. targetPlayer.UserId
		targetButton.Size = UDim2.new(1, -8, 0, 30)
		targetButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
		targetButton.BorderSizePixel = 0
		targetButton.TextColor3 = Color3.new(1, 1, 1)
		targetButton.Text = targetPlayer.DisplayName .. " (@" .. targetPlayer.Name .. ")"
		targetButton.TextScaled = true
		targetButton.Font = Enum.Font.SourceSans
		targetButton.LayoutOrder = targetPlayer.UserId
		targetButton.Parent = playerList
		targetButton.Activated:Connect(function()
			selectPlayer(targetPlayer, targetButton)
		end)
	end
	
	local function rebuildPlayerList()
		for _, child in playerList:GetChildren() do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
		local visiblePlayers = {}
		for _, targetPlayer in Players:GetPlayers() do
