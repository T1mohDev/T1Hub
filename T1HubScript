	local launchKey = Enum.KeyCode.R
	
	
	--------------------------------------------------
	-- LAUNCH
	--------------------------------------------------
	
	local function Launch()
		local character = player.Character
		if not character then
			return
		end
	
		local root = character:FindFirstChild("HumanoidRootPart")
		if not root then
			return
		end
	
		local camera = workspace.CurrentCamera
	
		root:ApplyImpulse(
			camera.CFrame.LookVector * 120
		)
	end
	
	
	--------------------------------------------------
	-- ПРЕОБРАЗОВАНИЕ ТЕКСТА В KEYCODE
	--------------------------------------------------
	
	local function GetKeyCode(text)
		text = tostring(text):upper():gsub("%s+", "")
	
		-- Например:
		-- R
		-- F
		-- Q
		-- SPACE
		-- LEFTSHIFT
	
		if text == "SPACE" then
			return Enum.KeyCode.Space
		end
	
		if text == "LEFTSHIFT" then
			return Enum.KeyCode.LeftShift
		end
	
		if text == "RIGHTSHIFT" then
			return Enum.KeyCode.RightShift
		end
	
		if text == "LEFTCTRL" or text == "LEFTCONTROL" then
			return Enum.KeyCode.LeftControl
		end
	
		if text == "RIGHTCTRL" or text == "RIGHTCONTROL" then
			return Enum.KeyCode.RightControl
		end
	
		if text == "ENTER" then
			return Enum.KeyCode.Return
		end
	
		if text == "TAB" then
			return Enum.KeyCode.Tab
		end
	
		if text == "BACKSPACE" then
			return Enum.KeyCode.Backspace
		end
	
		if text == "ESC" or text == "ESCAPE" then
			return Enum.KeyCode.Escape
		end
	
		if text == "UP" then
			return Enum.KeyCode.Up
		end
	
		if text == "DOWN" then
			return Enum.KeyCode.Down
		end
	
		if text == "LEFT" then
			return Enum.KeyCode.Left
		end
	
		if text == "RIGHT" then
			return Enum.KeyCode.Right
		end
	
		-- Обычные клавиши: A-Z, цифры и т.д.
		local success, keyCode = pcall(function()
			return Enum.KeyCode[text]
		end)
	
		if success and keyCode then
			return keyCode
		end
	
		return nil
	end
	
	
	--------------------------------------------------
	-- ИЗМЕНЕНИЕ КЛАВИШИ
	--------------------------------------------------
	
	textBox.ClearTextOnFocus = false
	
	textBox.FocusLost:Connect(function()
		local newKey = GetKeyCode(textBox.Text)
	
		if newKey then
			launchKey = newKey
	
			textBox.Text = launchKey.Name
	
			print("Launch key:", launchKey.Name)
		else
			-- Если введена неправильная клавиша
			textBox.Text = launchKey.Name
		end
	end)
	
	
	--------------------------------------------------
	-- НАЖАТИЕ ВЫБРАННОЙ КЛАВИШИ
	--------------------------------------------------
	
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
	
		if input.KeyCode == launchKey then
			Launch()
		end
	end)
end;
