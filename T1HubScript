			if tabButton then
				TweenService:Create(tabButton, tabFadeInfo, {
					BackgroundColor3 = mappedTabName == tabName and TAB_ACTIVE_COLOR or TAB_NORMAL_COLOR
				}):Play()
			end
		end
		animateTabIn(nextTab, direction)
		isSwitching = false
	end
	
	for buttonName, tabName in tabs do
		local button = frameMain:FindFirstChild(buttonName)
		if button then
			button.MouseButton1Click:Connect(function()
				openTab(tabName)
			end)
		end
	end
	
	for _, tabName in tabs do
		hideTab(frameMain:FindFirstChild(tabName))
	end
	
	activeTab = nil
	openTab("Frame1")
