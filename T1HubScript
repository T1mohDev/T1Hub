		for part, canCollide in pairs(savedCollision) do
			if part and part.Parent then
				part.CanCollide = canCollide
			end
		end
		table.clear(savedCollision)
	end
	
	local function setOrbitCollision(enabled)
		local character = localPlayer.Character
		if not character then
			return
		end
		if enabled then
			table.clear(savedCollision)
			for _, object in character:GetDescendants() do
				if object:IsA("BasePart") then
					savedCollision[object] = object.CanCollide
					object.CanCollide = false
				end
			end
		else
			restoreCollision()
		end
	end
	
	local function stopModes()
		followActive = false
		orbitActive = false
		trakActive = false
		setOrbitCollision(false)
		followButton.Text = "▶"
		orbitButton.Text = "▶"
		trakButton.Text = "▶"
	end
	
