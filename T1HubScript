			return
		end
	
		local nextTab = frameMain:FindFirstChild(tabName)
		if not nextTab then
			return
		end
	
		isSwitching = true
		local previousTab = activeTab and frameMain:FindFirstChild(activeTab)
		if previousTab then
			hideTab(previousTab)
		end
	
		for _, tab in tabs do
			local otherTab = frameMain:FindFirstChild(tab)
			if otherTab and otherTab ~= nextTab then
				hideTab(otherTab)
			end
		end
	
