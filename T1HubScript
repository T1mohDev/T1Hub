			local nickLabel = Instance.new("TextLabel")
			nickLabel.Size = UDim2.new(0, 130, 1, 0)
			nickLabel.Position = UDim2.new(0, xOffset, 0, 0)
			nickLabel.BackgroundTransparency = 1
			nickLabel.Text = sender .. ":"
			nickLabel.TextColor3 = isSystem and COLOR_SYSTEM or COLOR_NICK
			nickLabel.Font = Enum.Font.GothamBold
			nickLabel.TextSize = 12
			nickLabel.TextXAlignment = Enum.TextXAlignment.Left
			nickLabel.TextTruncate = Enum.TextTruncate.AtEnd
			nickLabel.Parent = row
			xOffset = xOffset + 132
		end
	
		-- Текст
		local textLabel = Instance.new("TextLabel")
		textLabel.Size = UDim2.new(1, -xOffset, 1, 0)
		textLabel.Position = UDim2.new(0, xOffset, 0, 0)
		textLabel.BackgroundTransparency = 1
		textLabel.Text = text
		textLabel.TextColor3 = isSystem and COLOR_SYSTEM or COLOR_PLAYER
		textLabel.Font = Enum.Font.Gotham
		textLabel.TextSize = 12
		textLabel.TextXAlignment = Enum.TextXAlignment.Left
		textLabel.TextTruncate = Enum.TextTruncate.AtEnd
		textLabel.Parent = row
	
		messageCount = messageCount + 1
		updateCounter()
	
		-- Ограничиваем количество
		local allRows = {}
		for _, c in ipairs(scroll:GetChildren()) do
			if c:IsA("Frame") then table.insert(allRows, c) end
		end
	
		if #allRows > MAX_LOG then
			allRows[1]:Destroy()
			messageCount = messageCount - 1
			updateCounter()
		end
	
		-- Автоскролл вниз
		task.defer(function()
			scroll.CanvasPosition = Vector2.new(0, scroll.AbsoluteCanvasSize.Y)
		end)
	end
	
	-- ============================================================
	-- ОБРАБОТКА СООБЩЕНИЙ
	-- ============================================================
	local function handleMessage(message)
		-- Системное?
		if not isPlayerMessage(message) then
			if not SHOW_SYSTEM then return end
			local clean = stripRichText(message.Text)
			if clean == "" then return end
			addMessage("", clean, true)
			return
		end
	
		-- Сообщение от игрока
		local displayName = getPlayerName(message)
		local clean = stripRichText(message.Text)
		if clean == "" then return end
	
		addMessage(displayName, clean, false)
	end
	
	-- ============================================================
	-- ХУКИ НА ЧАТ
	-- ============================================================
	local function hookChannel(channel)
		channel.MessageReceived:Connect(handleMessage)
	end
	
	-- Подключаем существующие каналы
	local ok, channels = pcall(function()
		return TextChatService:WaitForChild("TextChannels", 5):GetChildren()
	end)
	
	if ok and channels then
		for _, channel in ipairs(channels) do
			if channel:IsA("TextChannel") then
				hookChannel(channel)
			end
		end
	end
	
	-- Подключаем новые каналы
	TextChatService.TextChannels.ChildAdded:Connect(function(channel)
		if channel:IsA("TextChannel") then
			hookChannel(channel)
		end
	end)
	
	-- Также пробуем старый чат (для старых версий)
	if TextChatService.ChatVersion == Enum.ChatVersion.LegacyChatService then
		local ok2, chatEvents = pcall(function()
			return game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
		end)
		if ok2 and chatEvents then
			local onMessage = chatEvents:FindFirstChild("OnMessageDoneFiltering")
			if onMessage then
				onMessage.OnClientEvent:Connect(function(data)
					if not data or not data.Message then return end
					local sender = data.FromSpeaker or "Unknown"
					if sender == "Unknown" then return end
					local clean = stripRichText(data.Message)
					if clean ~= "" then
						addMessage(sender, clean, false)
					end
				end)
			end
		end
	end
	
	-- ============================================================
	-- КНОПКА ОЧИСТКИ
	-- ============================================================
	container.Header.Clear.MouseButton1Click:Connect(function()
		for _, c in ipairs(scroll:GetChildren()) do
			if c:IsA("Frame") then c:Destroy() end
		end
		messageCount = 0
		updateCounter()
	end)
	
	print("========================================")
	print("💬 Player Chat Log v3 загружен")
	print("📝 Логируются только сообщения игроков")
	print("🚫 Системные сообщения: " .. (SHOW_SYSTEM and "видны" or "скрыты"))
	print("========================================")
end;
