local function C_104()
local script = G2L["104"];
	local TweenService = game:GetService("TweenService")
	
	local button = script.Parent
	local menuFrame = button.Parent:WaitForChild("FrameChoise")
	
	local saved = {}
	local session = 0
	local animating = false
	
	local function getSaved(child)
		local s = saved[child]
		if not s then
			s = {
				position = child.Position,
				bg = child.BackgroundTransparency,
			}
			saved[child] = s
		end
		return s
	end
	
	local function closeMenu()
		session += 1
		menuFrame.Visible = false
		animating = false
	end
	
	button.MouseButton1Click:Connect(function()
		if menuFrame.Visible then
			closeMenu()
			return
		end
	
		if animating then
			return
		end
	
		session += 1
		local mySession = session
		animating = true
		menuFrame.Visible = true
	
		local items = {}
		for _, child in ipairs(menuFrame:GetChildren()) do
			if child:IsA("TextButton") then
				table.insert(items, child)
			end
		end
		table.sort(items, function(a, b)
			return a.AbsolutePosition.Y < b.AbsolutePosition.Y
		end)
	
		for i, child in ipairs(items) do
			local s = getSaved(child)
			child.Position = UDim2.new(s.position.X.Scale, s.position.X.Offset, s.position.Y.Scale, s.position.Y.Offset - 22)
			child.TextTransparency = 1
			child.BackgroundTransparency = 1
			task.delay((i - 1) * 0.04, function()
				if session ~= mySession then
					return
				end
				TweenService:Create(child, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					Position = s.position,
					TextTransparency = 0,
					BackgroundTransparency = s.bg,
				}):Play()
			end)
		end
	
		task.delay(#items * 0.04 + 0.15, function()
			if session == mySession then
				animating = false
			end
		end)
	end)
end;
