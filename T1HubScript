			joinByJobIdBox.Text = "JobId недоступен в Studio"
			showButtonStatus(copyJobIdButton, "JobId недоступен", 3)
			return
		end
	
		local copied = tryCopyToClipboard(jobId)
		if not copied then
			joinByJobIdBox.Text = jobId
