		local function setRole(p, newRole)
			if not p then return end
			local cur = _roles[p]
			if cur and HIGH_ROLES[cur] and newRole == "Innocent" then return end
			if cur ~= newRole then _roles[p] = newRole end
		end
	
		local function applyApiData(data)
			if type(data) ~= "table" then return end
			for key, value in pairs(data) do
				if type(value) ~= "table" then continue end
				local role = value.Role
				if not role then continue end
				local p = nil
				if value.UserId then p = Players:GetPlayerByUserId(value.UserId) end
				if not p and type(key) == "string" then p = Players:FindFirstChild(key) end
				if p then
					setRole(p, role)
					_dead[p] = value.Dead == true
				end
			end
		end
	
		local function refresh()
			local ok, data = pcall(function() return GetCurrentPlayerData:InvokeServer() end)
			if ok and data then applyApiData(data) end
