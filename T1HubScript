local function C_35()
local script = G2L["35"];
	local Players = game:GetService("Players")
	local Teams = game:GetService("Teams")
	
	local button = script.Parent
	local player = Players.LocalPlayer
	
	local espEnabled = false
	-- Храним хайлайты по игроку: [player] = { highlight = Highlight, character = character }
	local highlights = {}
	
	-- Проверяем, есть ли вообще команды в игре
	local function hasTeams()
		return #Teams:GetTeams() > 0
	end
	
	local function getHighlightColor(targetPlayer)
		-- Если в игре есть команды и игрок в команде — цвет команды
		if hasTeams() and targetPlayer.Team then
			return targetPlayer.Team.TeamColor.Color
		end
		-- Нет команд или игрок без команды — белый
		return Color3.fromRGB(255, 255, 255)
	end
	
	local function removeHighlight(targetPlayer)
		local data = highlights[targetPlayer]
		if data then
			if data.highlight and data.highlight.Parent then
				data.highlight:Destroy()
			end
			highlights[targetPlayer] = nil
		end
	end
	
	local function removeAll()
		for targetPlayer in pairs(highlights) do
			removeHighlight(targetPlayer)
		end
	end
	
	local function addHighlight(targetPlayer, character)
		if targetPlayer == player then return end
		if not character or not character.Parent then return end
	
		-- Удаляем старый хайлайт если был (например при респавне)
		removeHighlight(targetPlayer)
	
		local highlight = Instance.new("Highlight")
		highlight.FillColor = getHighlightColor(targetPlayer)
		highlight.FillTransparency = 0.7
		highlight.OutlineColor = highlight.FillColor
		highlight.OutlineTransparency = 0
		highlight.Adornee = character
		highlight.Parent = character
		highlights[targetPlayer] = { highlight = highlight, character = character }
	end
	
	local function refreshAll()
		for targetPlayer, data in pairs(highlights) do
			if data.highlight and data.highlight.Parent then
				local color = getHighlightColor(targetPlayer)
				data.highlight.FillColor = color
				data.highlight.OutlineColor = color
			end
		end
	end
	
	local function enableEsp()
		for _, targetPlayer in Players:GetPlayers() do
			if targetPlayer ~= player and targetPlayer.Character then
				addHighlight(targetPlayer, targetPlayer.Character)
			end
		end
	end
	
	-- Отслеживаем удаление персонажа (респавн, ресет)
	local function watchCharacterRemoval(targetPlayer, character)
		character.AncestryChanged:Connect(function(_, newParent)
			if newParent == nil then
				-- Персонаж удалён — чистим хайлайт
				local data = highlights[targetPlayer]
				if data and data.character == character then
					removeHighlight(targetPlayer)
				end
			end
		end)
	end
	
	-- Отслеживаем нового персонажа у игрока
	local function watchPlayer(targetPlayer)
		targetPlayer.CharacterAdded:Connect(function(character)
			if espEnabled then
				task.wait(0.3)
				if espEnabled and targetPlayer.Character == character then
					addHighlight(targetPlayer, character)
					watchCharacterRemoval(targetPlayer, character)
				end
			end
		end)
	
		-- Обновляем цвет при смене команды
		targetPlayer:GetPropertyChangedSignal("Team"):Connect(function()
			if espEnabled then
				refreshAll()
			end
		end)
	end
	
	-- Подключаем уже присутствующих игроков
	for _, targetPlayer in Players:GetPlayers() do
		watchPlayer(targetPlayer)
	end
	
	-- Подключаем новых игроков
	Players.PlayerAdded:Connect(watchPlayer)
	
	button.MouseButton1Click:Connect(function()
		espEnabled = not espEnabled
		button:SetAttribute("Toggled", espEnabled)
		if espEnabled then
			enableEsp()
			button.Text = "убрать подсветку"
		else
			removeAll()
			button.Text = "подсветить всех игроков"
		end
	end)
end;
