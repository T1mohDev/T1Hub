			return
		end
	
		setAnimationId("walk", "WalkAnim", WALK_ANIMATION_ID)
		setAnimationId("jump", "JumpAnim", JUMP_ANIMATION_ID)
		setAnimationId("fall", "FallAnim", FALL_ANIMATION_ID)
		setAnimationId("idle", "Animation1", IDLE_ANIMATION_ID)
		setAnimationId("idle", "Animation2", IDLE_ANIMATION_ID)
	end
	
	local function restoreAnimationPack()
		for animation, animationId in pairs(originalAnimationIds) do
			if animation and animation.Parent then
				animation.AnimationId = animationId
			end
		end
	
		originalAnimationIds = {}
		animateScript = nil
	end
	
