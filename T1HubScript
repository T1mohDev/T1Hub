				TweenService:Create(stroke, UNHOVER_INFO, {
					Color = getBaseStrokeColor(stroke),
					Transparency = getBaseStrokeTransparency(stroke),
				}):Play()
			end
		end)
	end
	
	local function connectObject(obj)
		if obj:IsA("TextButton") or obj:IsA("ImageButton") then
			connectButton(obj)
