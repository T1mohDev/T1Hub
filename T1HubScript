			humanoid:ChangeState(Enum.HumanoidStateType.Swimming)
		end
	end)
	
	player.CharacterAdded:Connect(function(newCharacter)
		if not enabled then
			return
		end
	
		task.defer(function()
			if enabled and newCharacter.Parent then
				getCharacterParts(newCharacter)
				prepareCharacter()
			end
		end)
	end)
	
	script.Destroying:Connect(function()
		if enabled then
			enabled = false
			restoreCharacterSettings()
		end
	end)
	
	setButtonState()
	
