			scale = Instance.new("UIScale")
			scale.Name = "TabSwitchScale"
			scale.Parent = guiObject
		end
		return scale
	end
	
	local function setTabTransparency(tab, value)
		for _, obj in tab:GetDescendants() do
			if obj:IsA("GuiObject") then
				local base = obj:GetAttribute("TabBaseBackgroundTransparency")
				if base == nil then
					base = obj.BackgroundTransparency
					obj:SetAttribute("TabBaseBackgroundTransparency", base)
				end
				obj.BackgroundTransparency = base + (1 - base) * value
			end
			if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
				local base = obj:GetAttribute("TabBaseTextTransparency")
				if base == nil then
					base = obj.TextTransparency
					obj:SetAttribute("TabBaseTextTransparency", base)
				end
				obj.TextTransparency = base + (1 - base) * value
			end
			if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
				local base = obj:GetAttribute("TabBaseImageTransparency")
				if base == nil then
					base = obj.ImageTransparency
					obj:SetAttribute("TabBaseImageTransparency", base)
				end
				obj.ImageTransparency = base + (1 - base) * value
			end
			if obj:IsA("UIStroke") then
				local base = obj:GetAttribute("TabBaseStrokeTransparency")
				if base == nil then
					base = obj.Transparency
					obj:SetAttribute("TabBaseStrokeTransparency", base)
				end
				obj.Transparency = base + (1 - base) * value
			end
		end
	end
	
	local function animateTabIn(tab, direction)
		local scale = getOrCreateScale(tab)
		tab.Visible = true
		tab.Position = tab.Position + UDim2.fromOffset(direction * 18, 0)
		scale.Scale = 0.96
		setTabTransparency(tab, 1)
	
		local positionTween = TweenService:Create(tab, tabFadeInfo, {
			Position = tab.Position - UDim2.fromOffset(direction * 18, 0),
		})
		local scaleTween = TweenService:Create(scale, tabScaleInfo, {Scale = 1})
		local fadeDriver = Instance.new("NumberValue")
		fadeDriver.Value = 1
		local fadeConnection = fadeDriver.Changed:Connect(function(value)
			setTabTransparency(tab, value)
		end)
		local fadeTween = TweenService:Create(fadeDriver, tabFadeInfo, {Value = 0})
	
		positionTween:Play()
		scaleTween:Play()
		fadeTween:Play()
		fadeTween.Completed:Wait()
		fadeConnection:Disconnect()
		fadeDriver:Destroy()
		setTabTransparency(tab, 0)
	end
	
	local function hideTab(tab)
		if tab then
			tab.Visible = false
			getOrCreateScale(tab).Scale = 1
			setTabTransparency(tab, 0)
		end
	end
	
	local function openTab(tabName)
		if isSwitching or activeTab == tabName then
			return
		end
	
		local nextTab = frameMain:FindFirstChild(tabName)
		if not nextTab then
			return
		end
	
		isSwitching = true
		local previousTab = activeTab and frameMain:FindFirstChild(activeTab)
		if previousTab then
			hideTab(previousTab)
		end
	
		for _, tab in tabs do
			local otherTab = frameMain:FindFirstChild(tab)
			if otherTab and otherTab ~= nextTab then
				hideTab(otherTab)
			end
		end
	
		local button = getButton(tabName)
		local direction = 1
		if button and previousTab then
			local previousButton = getButton(activeTab)
			if previousButton and button.AbsolutePosition.X < previousButton.AbsolutePosition.X then
				direction = -1
			end
		end
	
		activeTab = tabName
		for buttonName, mappedTabName in tabs do
			local tabButton = frameMain:FindFirstChild(buttonName)
			if tabButton then
				TweenService:Create(tabButton, tabFadeInfo, {
					BackgroundColor3 = mappedTabName == tabName and TAB_ACTIVE_COLOR or TAB_NORMAL_COLOR
				}):Play()
			end
		end
		animateTabIn(nextTab, direction)
		isSwitching = false
	end
	
	for buttonName, tabName in tabs do
		local button = frameMain:FindFirstChild(buttonName)
		if button then
			button.MouseButton1Click:Connect(function()
				openTab(tabName)
			end)
		end
	end
	
	for _, tabName in tabs do
		hideTab(frameMain:FindFirstChild(tabName))
	end
	
	activeTab = nil
	openTab("Frame1")
end;
