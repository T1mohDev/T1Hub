local function C_126()
local script = G2L["126"];
	-- ============================================================
	-- КНОПКА: FOREST (лесной шейдер)
	-- ============================================================
	local btn = script.Parent
	local Lighting = game:GetService("Lighting")
	local TweenService = game:GetService("TweenService")
	local PlayerGui = game.Players.LocalPlayer:WaitForChild("PlayerGui")
	
	-- ===================== ОБЩАЯ СИСТЕМА =====================
	_G.ShaderSys = _G.ShaderSys or {}
	local S = _G.ShaderSys
	
	if not S.original then
		S.original = {
			Brightness = Lighting.Brightness,
			ClockTime = Lighting.ClockTime,
			FogEnd = Lighting.FogEnd,
			FogStart = Lighting.FogStart,
			FogColor = Lighting.FogColor,
			Ambient = Lighting.Ambient,
			OutdoorAmbient = Lighting.OutdoorAmbient,
			GlobalShadows = Lighting.GlobalShadows,
			ShadowSoftness = Lighting.ShadowSoftness,
			EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
			EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
			ExposureCompensation = Lighting.ExposureCompensation,
		}
		S.originalEffects = {}
		for _, v in ipairs(Lighting:GetChildren()) do
			if v:IsA("PostEffect") or v:IsA("Atmosphere") or v:IsA("Sky") then
				table.insert(S.originalEffects, v:Clone())
			end
		end
	end
	
	if not S.active then S.active = nil end
	
	local function clearAllEffects()
		for _, v in ipairs(Lighting:GetChildren()) do
			if v:IsA("PostEffect") or v:IsA("Atmosphere") or v:IsA("Sky") then
				v:Destroy()
			end
		end
		local vg = PlayerGui:FindFirstChild("VignetteShader")
		if vg then vg:Destroy() end
	end
	
	local function createEffect(class, props)
		local e = Instance.new(class)
		for k, v in pairs(props) do e[k] = v end
		e.Parent = Lighting
		return e
	end
	
	local function applySmooth(duration, props, effects)
		for _, v in ipairs(Lighting:GetChildren()) do
			if v:IsA("PostEffect") then pcall(function() v.Enabled = false end) end
		end
		task.wait(0.05)
		clearAllEffects()
		for _, eff in ipairs(effects) do createEffect(eff.class, eff.props) end
		for k, v in pairs(props) do
			pcall(function()
				TweenService:Create(Lighting, TweenInfo.new(duration, Enum.EasingStyle.Quad), {[k] = v}):Play()
			end)
		end
	end
	
	local function restoreOriginal()
		clearAllEffects()
		for k, v in pairs(S.original) do Lighting[k] = v end
		for _, e in ipairs(S.originalEffects) do e:Clone().Parent = Lighting end
	end
	
	-- ===================== ПРЕСЕТ: FOREST =====================
	local function applyForest()
		applySmooth(0.7,
			{Brightness = 2.5, ClockTime = 13, FogEnd = 900, FogStart = 150,
				FogColor = Color3.fromRGB(180, 210, 180),
				Ambient = Color3.fromRGB(140, 165, 140),
				OutdoorAmbient = Color3.fromRGB(160, 190, 160),
				GlobalShadows = true, ShadowSoftness = 0.3,
				EnvironmentDiffuseScale = 0.6, EnvironmentSpecularScale = 0.35,
				ExposureCompensation = 0.1},
			{
				{class = "ColorCorrectionEffect", props = {Brightness = 0.05, Contrast = 0.1, Saturation = 0.2, TintColor = Color3.fromRGB(235, 255, 235)}},
				{class = "BloomEffect", props = {Intensity = 0.35, Size = 18, Threshold = 1.15}},
				{class = "SunRaysEffect", props = {Intensity = 0.1, Spread = 0.9}},
				{class = "Atmosphere", props = {Density = 0.3, Offset = 0.4, Color = Color3.fromRGB(200, 230, 200), Decay = Color3.fromRGB(170, 210, 170), Glare = 0.2, Haze = 1.2}},
			})
	end
	
	-- ===================== TOGGLE =====================
	local NAME = btn.Text:gsub("[▶II%s]", "")
	btn.Text = NAME .. " ▶"
	
	btn.MouseButton1Click:Connect(function()
		if S.active == btn then
			-- Выключаем
			S.active = nil
			btn.Text = NAME .. " ▶"
			restoreOriginal()
			print("[Shader] Forest OFF")
		else
			-- Выключаем предыдущую активную кнопку
			if S.active then
				local prev = S.active
				local prevName = prev.Text:gsub("[▶II%s]", "")
				prev.Text = prevName .. " ▶"
			end
			-- Включаем
			S.active = btn
			btn.Text = NAME .. " II"
			applyForest()
			print("[Shader] Forest ON")
		end
	end)
end;
