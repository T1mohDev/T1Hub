	end
	
	local function getOriginalSize(tab)
		local originalSize = tab:GetAttribute("TabsOriginalSize")
		if originalSize then
			return UDim2.new(originalSize.X.Scale, originalSize.X.Offset, originalSize.Y.Scale, originalSize.Y.Offset)
		end
	
		tab:SetAttribute("TabsOriginalSizeXScale", tab.Size.X.Scale)
		tab:SetAttribute("TabsOriginalSizeXOffset", tab.Size.X.Offset)
		tab:SetAttribute("TabsOriginalSizeYScale", tab.Size.Y.Scale)
		tab:SetAttribute("TabsOriginalSizeYOffset", tab.Size.Y.Offset)
		return tab.Size
	end
	
	local function restoreSize(tab)
		local xScale = tab:GetAttribute("TabsOriginalSizeXScale")
		local xOffset = tab:GetAttribute("TabsOriginalSizeXOffset")
		local yScale = tab:GetAttribute("TabsOriginalSizeYScale")
		local yOffset = tab:GetAttribute("TabsOriginalSizeYOffset")
		if xScale == nil then
			return tab.Size
		end
		return UDim2.new(xScale, xOffset, yScale, yOffset)
	end
	
	local function hideTab(tab)
		if tab then
			tab.Visible = false
			tab.Size = restoreSize(tab)
		end
	end
	
	local function openTab(tabName)
		if isAnimating or activeTab == tabName then
			return
		end
	
		local nextTab = frameMain:FindFirstChild(tabName)
		if not nextTab then
			return
		end
	
		isAnimating = true
		for _, mappedTabName in tabs do
			local otherTab = frameMain:FindFirstChild(mappedTabName)
			if otherTab and otherTab ~= nextTab then
				hideTab(otherTab)
			end
		end
	
		activeTab = tabName
		local choiceMenu = frameMain:FindFirstChild("FrameChoise")
		if choiceMenu then
			choiceMenu.Visible = false
		end
	
		local originalSize = restoreSize(nextTab)
		nextTab.Visible = true
		nextTab.Size = UDim2.new(originalSize.X.Scale, originalSize.X.Offset, 0, 0)
	
		local TweenService = game:GetService("TweenService")
		local unfold = TweenService:Create(
			nextTab,
			TweenInfo.new(0.38, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
			{ Size = originalSize }
		)
		unfold:Play()
		unfold.Completed:Wait()
		nextTab.Size = originalSize
		isAnimating = false
	end
	
	for buttonName, tabName in tabs do
		local button = getTabButton(buttonName)
		if button then
			button.MouseButton1Click:Connect(function()
				openTab(tabName)
			end)
		end
	end
	
	for _, tabName in tabs do
