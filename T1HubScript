local function C_10f()
local script = G2L["10f"];
	-- === ВСТАВИТЬ В LocalScript ВНУТРИ TextButton "Авто-подбор" ===
	local btn = script.Parent
	if not btn or not btn:IsA("TextButton") then
		return warn("[Auto-Pickup] Скрипт должен быть LocalScript внутри TextButton")
	end
	
	local Players = game:GetService("Players")
	local LocalPlayer = Players.LocalPlayer
	
	local ENABLED = false
	local lastPickup = 0
	local COOLDOWN = 3          -- секунд между подборами
	local TELEPORT_HEIGHT = 2.5 -- на сколько стадов поднять над пистолетом
	
	-- Проверка: есть ли у нас уже какое-то оружие
	local function hasWeapon()
		if not LocalPlayer.Character then return true end
		local bp = LocalPlayer:FindFirstChild("Backpack")
		local c = LocalPlayer.Character
		if c:FindFirstChild("Gun")   or (bp and bp:FindFirstChild("Gun"))   then return true end
		if c:FindFirstChild("Knife") or (bp and bp:FindFirstChild("Knife")) then return true end
		return false
	end
	
	-- Логика подбора
	local function tryPickup(gun)
		if not ENABLED then return end
		if tick() - lastPickup < COOLDOWN then return end
		if not gun or not gun.Parent then return end
		if gun.Parent ~= workspace then return end     -- уже подобрали?
		if hasWeapon() then return end
	
		local char = LocalPlayer.Character
		if not char then return end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		local handle = gun:FindFirstChild("Handle")
		if not hrp or not handle then return end
	
		lastPickup = tick()
	
		-- Телепорт к пистолету
		hrp.CFrame = handle.CFrame * CFrame.new(0, TELEPORT_HEIGHT, 0)
	
		-- Форсим "касание" через firetouchinterest (если доступно)
		task.wait(0.05)
		pcall(function()
			firetouchinterest(hrp, handle, 0)
			task.wait()
			firetouchinterest(hrp, handle, 1)
		end)
	end
	
	-- Слушаем появление упавших Tool в Workspace
	workspace.DescendantAdded:Connect(function(desc)
		if not ENABLED then return end
		if not desc:IsA("Tool") then return end
		if desc.Name ~= "Gun" then return end
	
		task.wait(0.25)   -- дать пистолету упасть на землю
		tryPickup(desc)
	end)
	
	-- Клик по кнопке — вкл/выкл
	btn.MouseButton1Click:Connect(function()
		ENABLED = not ENABLED
		btn:SetAttribute("Toggled", ENABLED)
		btn.Text = ENABLED and "автопобор оружия ON" or "автопобор оружия"
	end)
end;
