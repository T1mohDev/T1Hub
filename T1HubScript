local function C_ab()
local script = G2L["ab"];
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	
	local player = Players.LocalPlayer
	local button = script.Parent
	
	local WALK_SPEED = 16
	local SURFACE_DISTANCE = 4.5
	local SURFACE_OFFSET = 2.8
	local SURFACE_LOST_TIME = 0.2
	local SURFACE_BLEND_SPEED = 8
	local ORIENTATION_RESPONSIVENESS = 18
	local CAMERA_RESPONSIVENESS = 7
	local INPUT_RESPONSIVENESS = 10
	local FLOOR_DOT = 0.93
	local CAMERA_BIND_NAME = "WallWalkCamera"
	
	local state = _G.WallWalkState or {
		enabled = false,
		connection = nil,
		character = nil,
		humanoid = nil,
		root = nil,
		attachment = nil,
		velocity = nil,
		orientation = nil,
		onWall = false,
		surfaceNormal = Vector3.new(0, 1, 0),
		targetNormal = Vector3.new(0, 1, 0),
		lastSurfaceTime = 0,
		button = button,
	}
	_G.WallWalkState = state
	
	local function safeUnit(vector, fallback)
		if vector.Magnitude > 0.001 then
			return vector.Unit
		end
		return fallback
	end
	
	local function projectOntoPlane(vector, normal)
		local projected = vector - normal * vector:Dot(normal)
		if projected.Magnitude < 0.001 then
			return Vector3.zero
		end
		return projected.Unit
	end
	
	local function makeOrientation(normal, forwardHint)
		local up = safeUnit(normal, Vector3.new(0, 1, 0))
		local forward = projectOntoPlane(forwardHint, up)
		if forward.Magnitude < 0.001 then
			forward = projectOntoPlane(Vector3.new(0, 0, -1), up)
		end
		if forward.Magnitude < 0.001 then
			forward = projectOntoPlane(Vector3.new(1, 0, 0), up)
		end
		forward = safeUnit(forward, Vector3.new(0, 0, -1))
		local right = safeUnit(forward:Cross(up), Vector3.new(1, 0, 0))
		forward = safeUnit(up:Cross(right), forward)
		return CFrame.fromMatrix(Vector3.zero, right, up, -forward)
	end
	
	local function unbindCamera()
		RunService:UnbindToRenderStep(CAMERA_BIND_NAME)
	end
	
	local function cleanupConstraints()
		if state.velocity then
			state.velocity:Destroy()
			state.velocity = nil
		end
		if state.orientation then
			state.orientation:Destroy()
			state.orientation = nil
		end
		if state.attachment then
			state.attachment:Destroy()
			state.attachment = nil
		end
	end
	
	local function restoreCamera()
		unbindCamera()
		local camera = workspace.CurrentCamera
		if camera then
			camera.CameraType = Enum.CameraType.Custom
			if state.humanoid and state.humanoid.Parent then
				camera.CameraSubject = state.humanoid
			end
		end
	end
	
	local function leaveWallMode()
		state.onWall = false
		if state.velocity then
			state.velocity.Enabled = false
			state.velocity.VectorVelocity = Vector3.zero
		end
		if state.orientation then
			state.orientation.Enabled = false
		end
		if state.humanoid and state.humanoid.Parent then
			state.humanoid.AutoRotate = true
			state.humanoid.PlatformStand = false
			if state.humanoid.Health > 0 then
				state.humanoid:ChangeState(Enum.HumanoidStateType.Running)
			end
		end
		unbindCamera()
	end
	
	local function cleanup()
		leaveWallMode()
		cleanupConstraints()
		restoreCamera()
		state.character = nil
		state.humanoid = nil
		state.root = nil
		state.surfaceNormal = Vector3.new(0, 1, 0)
		state.targetNormal = Vector3.new(0, 1, 0)
		state.lastSurfaceTime = 0
	end
	
	local function setupCharacter(character)
		cleanup()
		if not character then
			return false
		end
	
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local root = character:FindFirstChild("HumanoidRootPart")
		if not humanoid or not root then
			return false
		end
	
		local attachment = Instance.new("Attachment")
		attachment.Name = "WallWalkAttachment"
		attachment.Parent = root
	
		local velocity = Instance.new("LinearVelocity")
		velocity.Name = "WallWalkVelocity"
		velocity.Attachment0 = attachment
		velocity.RelativeTo = Enum.ActuatorRelativeTo.World
		velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
		velocity.MaxForce = math.huge
		velocity.VectorVelocity = Vector3.zero
		velocity.Enabled = false
		velocity.Parent = root
	
		local orientation = Instance.new("AlignOrientation")
		orientation.Name = "WallWalkOrientation"
		orientation.Attachment0 = attachment
		orientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
		orientation.MaxTorque = math.huge
		orientation.Responsiveness = ORIENTATION_RESPONSIVENESS
		orientation.RigidityEnabled = false
		orientation.Enabled = false
		orientation.Parent = root
	
		state.character = character
		state.humanoid = humanoid
		state.root = root
		state.attachment = attachment
		state.velocity = velocity
		state.orientation = orientation
		state.onWall = false
		state.surfaceNormal = Vector3.new(0, 1, 0)
		state.targetNormal = Vector3.new(0, 1, 0)
		state.lastSurfaceTime = 0
		return true
	end
	
	local function raycastSurface(origin, direction, raycastParams)
		local result = workspace:Raycast(origin, direction * SURFACE_DISTANCE, raycastParams)
		if result and result.Instance and result.Instance.CanCollide then
			return result
		end
		return nil
	end
	
	local function findSurface(root, humanoid, raycastParams)
		local normal = state.surfaceNormal
		local candidates = {
			{ origin = root.Position, direction = -normal, priority = 1 },
			{ origin = root.Position, direction = root.CFrame.LookVector, priority = 2 },
			{ origin = root.Position, direction = -root.CFrame.LookVector, priority = 3 },
			{ origin = root.Position, direction = root.CFrame.RightVector, priority = 3 },
			{ origin = root.Position, direction = -root.CFrame.RightVector, priority = 3 },
		}
	
		local moveDirection = humanoid.MoveDirection
		if moveDirection.Magnitude > 0.1 then
			table.insert(candidates, 1, { origin = root.Position, direction = moveDirection.Unit, priority = 0 })
		end
	
		local bestResult
		local bestPriority = math.huge
		local bestDistance = math.huge
		for _, candidate in candidates do
			local result = raycastSurface(candidate.origin, candidate.direction, raycastParams)
			if result then
				local distance = (result.Position - candidate.origin).Magnitude
				if candidate.priority < bestPriority or (candidate.priority == bestPriority and distance < bestDistance) then
					bestResult = result
					bestPriority = candidate.priority
					bestDistance = distance
				end
			end
		end
		return bestResult
	end
	
	local function updateCamera(normal, dt)
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
	
		local current = camera.CFrame
		local look = current.LookVector
		local up = normal - look * normal:Dot(look)
		if up.Magnitude < 0.001 then
			return
		end
		up = up.Unit
		local right = safeUnit(look:Cross(up), current.RightVector)
		local target = CFrame.fromMatrix(current.Position, right, up, -look)
		local alpha = 1 - math.exp(-CAMERA_RESPONSIVENESS * dt)
		camera.CFrame = current:Lerp(target, alpha)
	end
	
	local function bindCamera()
		RunService:BindToRenderStep(CAMERA_BIND_NAME, Enum.RenderPriority.Camera.Value + 1, function(dt)
			if state.enabled and state.onWall and state.surfaceNormal then
				updateCamera(state.surfaceNormal, dt)
			end
		end)
	end
	
	local function enterWallMode()
		if state.onWall then
			return
		end
		state.onWall = true
		if state.humanoid and state.humanoid.Parent then
			state.humanoid.AutoRotate = false
			state.humanoid.PlatformStand = false
		end
		if state.velocity then
			state.velocity.Enabled = true
		end
		if state.orientation then
			state.orientation.Enabled = true
		end
		unbindCamera()
		bindCamera()
	end
	
	local function updateWallWalk(dt)
		if not state.enabled then
			return
		end
	
		local character = player.Character
		if not character then
			return
		end
		if character ~= state.character or not state.root or not state.root.Parent then
			if not setupCharacter(character) then
				return
			end
		end
	
		local root = state.root
		local humanoid = state.humanoid
		if not root or not humanoid or not state.velocity or not state.orientation then
			return
		end
	
		local raycastParams = RaycastParams.new()
		raycastParams.FilterType = Enum.RaycastFilterType.Exclude
		raycastParams.FilterDescendantsInstances = { character }
	
		local surface = findSurface(root, humanoid, raycastParams)
		if surface then
			local detectedNormal = safeUnit(surface.Normal, state.targetNormal)
			state.targetNormal = detectedNormal
			state.lastSurfaceTime = os.clock()
			if detectedNormal:Dot(Vector3.new(0, 1, 0)) < FLOOR_DOT then
				enterWallMode()
			end
		end
	
		local hasSurface = os.clock() - state.lastSurfaceTime <= SURFACE_LOST_TIME
		if not hasSurface then
			leaveWallMode()
			state.surfaceNormal = Vector3.new(0, 1, 0)
			state.targetNormal = Vector3.new(0, 1, 0)
			return
		end
	
		local normalAlpha = 1 - math.exp(-SURFACE_BLEND_SPEED * dt)
		state.surfaceNormal = safeUnit(state.surfaceNormal:Lerp(state.targetNormal, normalAlpha), state.targetNormal)
		local normal = state.surfaceNormal
		local isFloor = normal:Dot(Vector3.new(0, 1, 0)) >= FLOOR_DOT
		if isFloor then
			leaveWallMode()
			state.surfaceNormal = Vector3.new(0, 1, 0)
			return
		end
		if not state.onWall then
			enterWallMode()
		end
	
		local camera = workspace.CurrentCamera
		local cameraForward = camera and camera.CFrame.LookVector or root.CFrame.LookVector
		local tangentCameraForward = projectOntoPlane(cameraForward, normal)
		local tangentMove = projectOntoPlane(humanoid.MoveDirection, normal)
		local forward = safeUnit(tangentMove, safeUnit(tangentCameraForward, projectOntoPlane(root.CFrame.LookVector, normal)))
		local desiredOrientation = makeOrientation(normal, forward)
	
		state.orientation.CFrame = desiredOrientation
		state.orientation.Enabled = true
	
		local movement = tangentMove
		if movement.Magnitude > 0.001 then
			movement = movement.Unit * WALK_SPEED
