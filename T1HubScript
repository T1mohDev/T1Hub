					base = object.BackgroundTransparency
					object:SetAttribute("LoginAnimationBaseBackgroundTransparency", base)
				end
				object.BackgroundTransparency = base + (1 - base) * ratio
			end
	
			if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
				local base = object:GetAttribute("LoginAnimationBaseTextTransparency")
