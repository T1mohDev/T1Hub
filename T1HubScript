local function C_2()
local script = G2L["2"];
	local TweenService = game:GetService("TweenService")
	
	local screenGui = script.Parent
	local openFrame = screenGui:FindFirstChild("OpenFrame")
	local frameMain = screenGui:FindFirstChild("FrameMain")
	local openButton = openFrame and openFrame:FindFirstChild("Open")
	if not openFrame or not frameMain or not openButton then
		return
	end
	
	local panelParent = frameMain.Parent
	local closedScale = 0.06
	local isOpen = false
	local isAnimating = false
	local hasOpened = false
	
	local savedPosition = frameMain.Position
	local savedAnchor = frameMain.AnchorPoint
	local savedSize = frameMain.Size
	
	local panelScale = frameMain:FindFirstChild("OpenCloseScale")
	if not panelScale then
		panelScale = Instance.new("UIScale")
		panelScale.Name = "OpenCloseScale"
		panelScale.Parent = frameMain
	end
	
	local function getCenterScreenPoint(guiObject)
		return guiObject.AbsolutePosition + guiObject.AbsoluteSize / 2
	end
	
	local function getPositionFromScreenPoint(point, anchorPoint, size)
		local parentPosition = panelParent.AbsolutePosition
		local parentSize = panelParent.AbsoluteSize
		local absoluteSize = Vector2.new(
			size.X.Scale * parentSize.X + size.X.Offset,
			size.Y.Scale * parentSize.Y + size.Y.Offset
		)
		local anchorOffset = absoluteSize * anchorPoint
		return UDim2.fromOffset(
			point.X - parentPosition.X - anchorOffset.X,
			point.Y - parentPosition.Y - anchorOffset.Y
		)
	end
	
	local function getCenterForFrame(position, anchorPoint, size)
		local parentPosition = panelParent.AbsolutePosition
		local parentSize = panelParent.AbsoluteSize
		local absoluteSize = Vector2.new(
			size.X.Scale * parentSize.X + size.X.Offset,
			size.Y.Scale * parentSize.Y + size.Y.Offset
		)
		local topLeft = parentPosition + Vector2.new(
			position.X.Scale * parentSize.X + position.X.Offset - anchorPoint.X * absoluteSize.X,
			position.Y.Scale * parentSize.Y + position.Y.Offset - anchorPoint.Y * absoluteSize.Y
		)
		return topLeft + absoluteSize / 2
	end
	
	local function applyTransparency(ratio)
		local visibleAmount = math.clamp(ratio, 0, 1)
		for _, obj in frameMain:GetDescendants() do
			if obj:IsA("GuiObject") then
				local base = obj:GetAttribute("BaseBackgroundTransparency")
				if base == nil then
					base = obj.BackgroundTransparency
					obj:SetAttribute("BaseBackgroundTransparency", base)
				end
				obj.BackgroundTransparency = base + (1 - base) * (1 - visibleAmount)
			end
			if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
				local base = obj:GetAttribute("BaseTextTransparency")
				if base == nil then
					base = obj.TextTransparency
					obj:SetAttribute("BaseTextTransparency", base)
				end
				obj.TextTransparency = base + (1 - base) * (1 - visibleAmount)
			end
			if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
				local base = obj:GetAttribute("BaseImageTransparency")
				if base == nil then
					base = obj.ImageTransparency
					obj:SetAttribute("BaseImageTransparency", base)
				end
				obj.ImageTransparency = base + (1 - base) * (1 - visibleAmount)
			end
			if obj:IsA("UIStroke") then
				local base = obj:GetAttribute("BaseStrokeTransparency")
				if base == nil then
					base = obj.Transparency
					obj:SetAttribute("BaseStrokeTransparency", base)
				end
				obj.Transparency = base + (1 - base) * (1 - visibleAmount)
			end
		end
	
		local baseMain = frameMain:GetAttribute("BaseBackgroundTransparency")
		if baseMain == nil then
			baseMain = frameMain.BackgroundTransparency
			frameMain:SetAttribute("BaseBackgroundTransparency", baseMain)
		end
		frameMain.BackgroundTransparency = baseMain + (1 - baseMain) * (1 - visibleAmount)
	end
	
	local function saveCurrentDestination()
		savedPosition = frameMain.Position
		savedAnchor = frameMain.AnchorPoint
		savedSize = frameMain.Size
	end
	
	local function restoreDestination()
		frameMain.AnchorPoint = savedAnchor
		frameMain.Position = savedPosition
		frameMain.Size = savedSize
		panelScale.Scale = 1
		applyTransparency(1)
	end
	
	local function playVisibilityFade(fromValue, toValue, duration, easingDirection)
		local driver = Instance.new("NumberValue")
		driver.Value = fromValue
		local connection = driver.Changed:Connect(applyTransparency)
		local tween = TweenService:Create(driver, TweenInfo.new(duration, Enum.EasingStyle.Quint, easingDirection), { Value = toValue })
		tween:Play()
		tween.Completed:Wait()
		connection:Disconnect()
		driver:Destroy()
		applyTransparency(toValue)
	end
	
	local function getFirstOpenDestination()
		return Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)
	end
	
	local function toggleFrame()
		if isAnimating then
			return
		end
	
		isAnimating = true
		local buttonCenter = getCenterScreenPoint(openButton)
	
		if not isOpen then
			if not hasOpened then
				savedAnchor, savedPosition = getFirstOpenDestination()
				hasOpened = true
			end
	
			local targetAnchor = savedAnchor
			local targetPosition = savedPosition
			local targetSize = savedSize
			frameMain.Visible = true
			frameMain.AnchorPoint = targetAnchor
			frameMain.Position = getPositionFromScreenPoint(buttonCenter, targetAnchor, targetSize)
			frameMain.Size = targetSize
			panelScale.Scale = closedScale
			applyTransparency(0)
	
			local duration = 0.85
			local motionTween = TweenService:Create(frameMain, TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
				Position = targetPosition,
			})
			local scaleTween = TweenService:Create(panelScale, TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
				Scale = 1,
			})
			motionTween:Play()
			scaleTween:Play()
			playVisibilityFade(0, 1, duration, Enum.EasingDirection.Out)
			restoreDestination()
			frameMain.Visible = true
			isOpen = true
		else
			saveCurrentDestination()
			local currentCenter = getCenterForFrame(savedPosition, savedAnchor, savedSize)
			frameMain.AnchorPoint = Vector2.new(0.5, 0.5)
			frameMain.Position = getPositionFromScreenPoint(currentCenter, frameMain.AnchorPoint, savedSize)
			frameMain.Size = savedSize
			panelScale.Scale = 1
			applyTransparency(1)
	
			local duration = 0.85
			local motionTween = TweenService:Create(frameMain, TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
				Position = getPositionFromScreenPoint(buttonCenter, frameMain.AnchorPoint, savedSize),
			})
			local scaleTween = TweenService:Create(panelScale, TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
				Scale = closedScale,
			})
			motionTween:Play()
			scaleTween:Play()
			playVisibilityFade(1, 0, duration, Enum.EasingDirection.In)
			frameMain.Visible = false
			restoreDestination()
			isOpen = false
		end
	
		isAnimating = false
	end
	
	openButton.MouseButton1Click:Connect(toggleFrame)
	
	frameMain.Visible = false
	restoreDestination()
end;
