	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local UserInputService = game:GetService("UserInputService")
	
	local button = script.Parent
	local player = Players.LocalPlayer
	
	local frame = button.Parent
	local speedBox = frame:FindFirstChild("TextBox")
	
	local function getFlySpeed()
		if speedBox then
			local speed = tonumber(speedBox.Text)
			if speed and speed > 0 then
				return math.min(speed, 1000)
			end
		end
		return 60
	end
	
	local flying = false
	local bodyVelocity = nil
	local bodyGyro = nil
	local keys = {
		W = false,
		A = false,
		S = false,
		D = false,
		Space = false,
		LeftShift = false,
	}
	
	local function getCharacter()
		local character = player.Character
		if not character or character.Parent == nil then
			return nil
		end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if humanoid and hrp and humanoid.Health > 0 then
			return character, humanoid, hrp
		end
		return nil
	end
	
	local function stopFly()
		flying = false
		button:SetAttribute("Toggled", false)
		if bodyVelocity then
			bodyVelocity:Destroy()
			bodyVelocity = nil
		end
		if bodyGyro then
			bodyGyro:Destroy()
			bodyGyro = nil
		end
		local character, humanoid = getCharacter()
		if humanoid then
			humanoid.PlatformStand = false
		end
		button.Text = "▶"
	end
	
	local function startFly()
		local character, humanoid, hrp = getCharacter()
		if not character then
			return
		end
		flying = true
		button:SetAttribute("Toggled", true)
		humanoid.PlatformStand = true
	
		bodyVelocity = Instance.new("BodyVelocity")
		bodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
		bodyVelocity.Velocity = Vector3.zero
		bodyVelocity.Parent = hrp
	
		bodyGyro = Instance.new("BodyGyro")
		bodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
		bodyGyro.P = 9000
		bodyGyro.D = 500
		bodyGyro.CFrame = hrp.CFrame
		bodyGyro.Parent = hrp
	
		button.Text = "II"
	
		humanoid.Died:Connect(stopFly)
	end
	
	button.MouseButton1Click:Connect(function()
		if flying then
			stopFly()
		else
			startFly()
		end
	end)
	
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end
		local keyName = input.KeyCode.Name
		if keys[keyName] ~= nil then
			keys[keyName] = true
		end
	end)
	
	UserInputService.InputEnded:Connect(function(input, gameProcessed)
		local keyName = input.KeyCode.Name
		if keys[keyName] ~= nil then
			keys[keyName] = false
		end
	end)
	
	RunService.RenderStepped:Connect(function()
		if not flying then
			return
		end
	
		local character, humanoid, hrp = getCharacter()
		if not character then
			stopFly()
			return
		end
	
		local camera = workspace.CurrentCamera
		local look = camera.CFrame.LookVector
		local right = camera.CFrame.RightVector
	
		local moveDir = Vector3.zero
		if keys.W then
			moveDir += look
		end
		if keys.S then
			moveDir -= look
		end
		if keys.D then
			moveDir += right
		end
		if keys.A then
			moveDir -= right
		end
		if keys.Space then
			moveDir += Vector3.new(0, 1, 0)
		end
		if keys.LeftShift then
			moveDir -= Vector3.new(0, 1, 0)
		end
	
		if moveDir.Magnitude > 0 then
			moveDir = moveDir.Unit * getFlySpeed()
		end
	
		if bodyVelocity then
			bodyVelocity.Velocity = moveDir
		end
		if bodyGyro then
			bodyGyro.CFrame = camera.CFrame
		end
	end)
	
	-- Если персонаж умер или переспавнился — сбрасываем состояние
	player.CharacterAdded:Connect(function()
		stopFly()
	end)
	
end;
