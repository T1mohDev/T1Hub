		if not force and waterVolumeCFrame and (position - waterVolumeCFrame.Position).Magnitude < WATER_VOLUME_UPDATE_DISTANCE then
			return
		end
	
		if waterVolumeCFrame then
			terrain:FillBlock(waterVolumeCFrame, WATER_VOLUME_SIZE, Enum.Material.Air)
		end
	
		waterVolumeCFrame = CFrame.new(position)
