	local function startFreeCam()
		if freeCamEnabled then
			return
		end
	
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
	
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not humanoid or not root or humanoid.Health <= 0 then
			return
		end
	
		freeCamEnabled = true
		freeCamFrameMainVisible = frameMain.Visible
		frameMain.Visible = false
		createFreeCamHint().Visible = true
		freeCamMouseBehavior = UserInputService.MouseBehavior
		freeCamMouseIconEnabled = UserInputService.MouseIconEnabled
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		freeCamHumanoid = humanoid
		freeCamRoot = root
		freeCamRootAnchored = root.Anchored
		freeCamWalkSpeed = humanoid.WalkSpeed
		freeCamJumpPower = humanoid.JumpPower
		freeCamJumpHeight = humanoid.JumpHeight
		freeCamAutoRotate = humanoid.AutoRotate
		freeCamPlatformStand = humanoid.PlatformStand
		humanoid.WalkSpeed = 0
		if humanoid.UseJumpPower then
			humanoid.JumpPower = 0
		else
			humanoid.JumpHeight = 0
		end
		humanoid.AutoRotate = false
		humanoid.PlatformStand = true
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		root.Anchored = true
		bindFreeCamMovement()
	
		freeCamPosition = camera.CFrame.Position
		local lookVector = camera.CFrame.LookVector
		freeCamYaw = math.atan2(-lookVector.X, -lookVector.Z)
		freeCamPitch = math.asin(math.clamp(lookVector.Y, -1, 1))
		camera.CameraType = Enum.CameraType.Scriptable
		updateFreeCamButton()
	
		freeCamConnection = RunService.RenderStepped:Connect(function(deltaTime)
			if not freeCamEnabled then
				return
			end
	
			if freeCamRoot and freeCamRoot.Parent then
				freeCamRoot.AssemblyLinearVelocity = Vector3.zero
				freeCamRoot.AssemblyAngularVelocity = Vector3.zero
			end
			if freeCamHumanoid and freeCamHumanoid.Parent then
				freeCamHumanoid:Move(Vector3.zero, true)
			end
	
			local mouseDelta = UserInputService:GetMouseDelta()
			freeCamYaw -= mouseDelta.X * 0.003
			freeCamPitch = math.clamp(freeCamPitch - mouseDelta.Y * 0.003, math.rad(-89), math.rad(89))
	
			local lookRotation = CFrame.Angles(0, freeCamYaw, 0) * CFrame.Angles(freeCamPitch, 0, 0)
			local moveDirection = Vector3.zero
			local forwardPressed = UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up)
			local backwardPressed = UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down)
			local rightPressed = UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right)
			local leftPressed = UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left)
			local upPressed = UserInputService:IsKeyDown(Enum.KeyCode.E) or UserInputService:IsKeyDown(Enum.KeyCode.Space)
			local downPressed = UserInputService:IsKeyDown(Enum.KeyCode.Q) or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
			if forwardPressed then
				moveDirection += lookRotation.LookVector
			end
			if backwardPressed then
				moveDirection -= lookRotation.LookVector
			end
			if rightPressed then
				moveDirection += lookRotation.RightVector
			end
			if leftPressed then
				moveDirection -= lookRotation.RightVector
			end
			if upPressed then
				moveDirection += Vector3.yAxis
			end
			if downPressed then
				moveDirection -= Vector3.yAxis
			end
	
			if moveDirection.Magnitude > 0 then
				freeCamPosition += moveDirection.Unit * 48 * deltaTime
			end
	
			camera.CFrame = CFrame.new(freeCamPosition) * lookRotation
		end)
	end
	
