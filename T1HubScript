	local isSwitching = false
	local tabScaleInfo = TweenInfo.new(0.26, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	local tabFadeInfo = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	
	local TAB_NORMAL_COLOR = Color3.fromRGB(22, 22, 27)
	local TAB_ACTIVE_COLOR = Color3.fromRGB(40, 40, 47)
	
	local function getTab(buttonName)
		local tabName = tabs[buttonName]
		return tabName and frameMain:FindFirstChild(tabName)
	end
	
	local function getButton(tabName)
		for buttonName, mappedTabName in tabs do
			if mappedTabName == tabName then
				return frameMain:FindFirstChild(buttonName)
			end
		end
	end
	
	local function getOrCreateScale(guiObject)
		local scale = guiObject:FindFirstChild("TabSwitchScale")
		if not scale then
			scale = Instance.new("UIScale")
			scale.Name = "TabSwitchScale"
			scale.Parent = guiObject
		end
		return scale
	end
	
	local function setTabTransparency(tab, value)
		for _, obj in tab:GetDescendants() do
			if obj:IsA("GuiObject") then
				local base = obj:GetAttribute("TabBaseBackgroundTransparency")
				if base == nil then
					base = obj.BackgroundTransparency
					obj:SetAttribute("TabBaseBackgroundTransparency", base)
				end
				obj.BackgroundTransparency = base + (1 - base) * value
			end
			if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
				local base = obj:GetAttribute("TabBaseTextTransparency")
				if base == nil then
					base = obj.TextTransparency
					obj:SetAttribute("TabBaseTextTransparency", base)
				end
				obj.TextTransparency = base + (1 - base) * value
			end
			if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
				local base = obj:GetAttribute("TabBaseImageTransparency")
				if base == nil then
					base = obj.ImageTransparency
					obj:SetAttribute("TabBaseImageTransparency", base)
				end
				obj.ImageTransparency = base + (1 - base) * value
			end
			if obj:IsA("UIStroke") then
				local base = obj:GetAttribute("TabBaseStrokeTransparency")
				if base == nil then
					base = obj.Transparency
					obj:SetAttribute("TabBaseStrokeTransparency", base)
				end
				obj.Transparency = base + (1 - base) * value
			end
		end
	end
	
	local function animateTabIn(tab, direction)
		local scale = getOrCreateScale(tab)
		tab.Visible = true
		tab.Position = tab.Position + UDim2.fromOffset(direction * 18, 0)
		scale.Scale = 0.96
		setTabTransparency(tab, 1)
	
		local positionTween = TweenService:Create(tab, tabFadeInfo, {
			Position = tab.Position - UDim2.fromOffset(direction * 18, 0),
		})
		local scaleTween = TweenService:Create(scale, tabScaleInfo, {Scale = 1})
		local fadeDriver = Instance.new("NumberValue")
		fadeDriver.Value = 1
		local fadeConnection = fadeDriver.Changed:Connect(function(value)
			setTabTransparency(tab, value)
		end)
		local fadeTween = TweenService:Create(fadeDriver, tabFadeInfo, {Value = 0})
	
		positionTween:Play()
		scaleTween:Play()
		fadeTween:Play()
		fadeTween.Completed:Wait()
		fadeConnection:Disconnect()
		fadeDriver:Destroy()
		setTabTransparency(tab, 0)
