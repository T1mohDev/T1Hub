local function C_2()
local script = G2L["2"];
	local TweenService = game:GetService("TweenService")
	local UserInputService = game:GetService("UserInputService")
	
	local screenGui = script.Parent
	screenGui.DisplayOrder = 2147483646
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGui.IgnoreGuiInset = true
	
	local CURSOR_ORDER = 2147483647
	local PANEL_ORDER = CURSOR_ORDER - 1
	
	local function keepAdminGuiOnTop()
		local highest = 0
		local playerGui = screenGui.Parent
		if playerGui then
			for _, gui in playerGui:GetChildren() do
				if gui:IsA("ScreenGui") and gui ~= screenGui and gui.Name ~= "CustomCursorOverlay" then
					highest = math.max(highest, gui.DisplayOrder)
				end
			end
		end
		local target = math.min(PANEL_ORDER, highest + 1)
		if screenGui.DisplayOrder ~= target then
			screenGui.DisplayOrder = target
		end
	end
	
	keepAdminGuiOnTop()
	
	local openFrame = screenGui:FindFirstChild("OpenFrame")
	local frameMain = screenGui:FindFirstChild("FrameMain")
	local openButton = openFrame and openFrame:FindFirstChild("Open")
	local collapseButton = frameMain and frameMain:FindFirstChild("Svernut")
	if not openFrame or not frameMain or not openButton or not collapseButton then
		return
	end
	
	local isOpen = false
	local isAnimating = false
	local closedScale = 0.96
	local animationDuration = 0.3
	
	local panelScale = frameMain:FindFirstChild("OpenCloseScale")
	if not panelScale then
		panelScale = Instance.new("UIScale")
		panelScale.Name = "OpenCloseScale"
		panelScale.Parent = frameMain
	end
	
	local function applyTransparency(ratio)
		local visibleAmount = math.clamp(ratio, 0, 1)
		for _, obj in frameMain:GetDescendants() do
			if obj:IsA("GuiObject") then
				local base = obj:GetAttribute("BaseBackgroundTransparency")
				if base == nil then
					base = obj.BackgroundTransparency
					obj:SetAttribute("BaseBackgroundTransparency", base)
				end
				obj.BackgroundTransparency = base + (1 - base) * (1 - visibleAmount)
			end
			if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
				local base = obj:GetAttribute("BaseTextTransparency")
				if base == nil then
					base = obj.TextTransparency
					obj:SetAttribute("BaseTextTransparency", base)
				end
				obj.TextTransparency = base + (1 - base) * (1 - visibleAmount)
			end
			if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
				local base = obj:GetAttribute("BaseImageTransparency")
				if base == nil then
					base = obj.ImageTransparency
					obj:SetAttribute("BaseImageTransparency", base)
				end
				obj.ImageTransparency = base + (1 - base) * (1 - visibleAmount)
			end
			if obj:IsA("UIStroke") then
				local base = obj:GetAttribute("BaseStrokeTransparency")
				if base == nil then
					base = obj.Transparency
					obj:SetAttribute("BaseStrokeTransparency", base)
				end
				obj.Transparency = base + (1 - base) * (1 - visibleAmount)
			end
		end
	
		local baseMain = frameMain:GetAttribute("BaseBackgroundTransparency")
		if baseMain == nil then
			baseMain = frameMain.BackgroundTransparency
			frameMain:SetAttribute("BaseBackgroundTransparency", baseMain)
		end
		frameMain.BackgroundTransparency = baseMain + (1 - baseMain) * (1 - visibleAmount)
	end
	
	local function tweenVisibility(fromValue, toValue, easingDirection)
		local driver = Instance.new("NumberValue")
		driver.Value = fromValue
		local connection = driver.Changed:Connect(applyTransparency)
		local tween = TweenService:Create(
			driver,
			TweenInfo.new(animationDuration, Enum.EasingStyle.Quad, easingDirection),
			{ Value = toValue }
		)
		tween:Play()
		tween.Completed:Wait()
		connection:Disconnect()
		driver:Destroy()
		applyTransparency(toValue)
	end
	
	local function animatePanel(opening)
		if isAnimating or opening == isOpen then
			return
		end
	
		isAnimating = true
		frameMain.Visible = true
	
		local targetScale = if opening then 1 else closedScale
		local startScale = if opening then closedScale else 1
		local startVisibility = if opening then 0 else 1
		local endVisibility = if opening then 1 else 0
		panelScale.Scale = startScale
		applyTransparency(startVisibility)
	
		local scaleTween = TweenService:Create(
			panelScale,
			TweenInfo.new(animationDuration, Enum.EasingStyle.Quad, if opening then Enum.EasingDirection.Out else Enum.EasingDirection.In),
			{ Scale = targetScale }
		)
		scaleTween:Play()
		tweenVisibility(startVisibility, endVisibility, if opening then Enum.EasingDirection.Out else Enum.EasingDirection.In)
	
		if opening then
			panelScale.Scale = 1
			applyTransparency(1)
			frameMain.Visible = true
		else
			panelScale.Scale = closedScale
			frameMain.Visible = false
			panelScale.Scale = 1
			applyTransparency(1)
		end
	
		isOpen = opening
		isAnimating = false
	end
	
	openButton.MouseButton1Click:Connect(function()
		animatePanel(not isOpen)
	end)
	
	collapseButton.MouseButton1Click:Connect(function()
		animatePanel(false)
	end)
	
	local RunService = game:GetService("RunService")
	RunService.RenderStepped:Connect(function()
		keepAdminGuiOnTop()
		if screenGui.ZIndexBehavior ~= Enum.ZIndexBehavior.Sibling then
			screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		end
	end)
	
	UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
		if gameProcessedEvent then
			return
		end
		if input.KeyCode == Enum.KeyCode.RightAlt then
			animatePanel(not isOpen)
		end
	end)
	
	frameMain.Visible = false
	panelScale.Scale = 1
	applyTransparency(1)
end;
