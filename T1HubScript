			Innocent = Color3.fromRGB(0, 255, 0),
		}
		_G.RE.roles = {}
		_G.RE.dead = {}
		_G.RE.enabled = {Murderer = false, Sheriff = false, Hero = false, Innocent = false}
		_G.RE.highlights = {}
	
