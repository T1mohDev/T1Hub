-- StarterGui.T1Hub.FrameMain.Frame2.Esp.EspScript
local function C_2b()
local script = G2L["2b"];
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local Workspace = game:GetService("Workspace")
	
	local button = script.Parent
	local localPlayer = Players.LocalPlayer
	local espEnabled = false
	local highlights = {}
	local playerConnections = {}
	local characterVersions = {}
	local reconcileConnection
	local reconcileAccumulator = 0
	
	local espFolder = Workspace:FindFirstChild("T1HubESPHighlights")
	if not espFolder then
		espFolder = Instance.new("Folder")
		espFolder.Name = "T1HubESPHighlights"
		espFolder.Parent = Workspace
	end
	
	for _, child in ipairs(espFolder:GetChildren()) do
		if child:IsA("Highlight") then
			child:Destroy()
		end
	end
	
	local function getHighlightColor(targetPlayer)
		if targetPlayer.Team then
			return targetPlayer.Team.TeamColor.Color
		end
		return Color3.fromRGB(255, 255, 255)
	end
	
	local function destroyHighlight(targetPlayer)
		local highlight = highlights[targetPlayer]
		highlights[targetPlayer] = nil
		if highlight then
			highlight:Destroy()
		end
	end
	
	local function destroyAllHighlights()
		for targetPlayer in pairs(highlights) do
			destroyHighlight(targetPlayer)
		end
		for _, child in ipairs(espFolder:GetChildren()) do
			if child:IsA("Highlight") then
				child:Destroy()
			end
		end
	end
	
	local function isCurrentCharacter(targetPlayer, character)
		return targetPlayer.Character == character and character.Parent ~= nil and character:IsDescendantOf(Workspace)
	end
	
	local function syncPlayer(targetPlayer)
		if not espEnabled or targetPlayer == localPlayer then
			if targetPlayer ~= localPlayer then
				destroyHighlight(targetPlayer)
			end
			return
		end
	
		local character = targetPlayer.Character
		if not isCurrentCharacter(targetPlayer, character) then
			destroyHighlight(targetPlayer)
			return
		end
	
		local color = getHighlightColor(targetPlayer)
		local highlight = highlights[targetPlayer]
		if not highlight or not highlight.Parent or highlight.Adornee ~= character then
			destroyHighlight(targetPlayer)
			highlight = Instance.new("Highlight")
			highlight.Name = "ESP_" .. targetPlayer.UserId
			highlight.Adornee = character
			highlight.FillTransparency = 0.68
			highlight.OutlineTransparency = 0
			highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			highlight.Parent = espFolder
			highlights[targetPlayer] = highlight
		end
	
		highlight.Enabled = true
		highlight.FillColor = color
		highlight.OutlineColor = color
	end
	
	local function syncAllPlayers()
		for _, targetPlayer in ipairs(Players:GetPlayers()) do
			if targetPlayer ~= localPlayer then
				syncPlayer(targetPlayer)
			end
		end
	end
	
	local function watchCharacter(targetPlayer, character)
		characterVersions[targetPlayer] = (characterVersions[targetPlayer] or 0) + 1
		local version = characterVersions[targetPlayer]
	
		task.spawn(function()
			local deadline = os.clock() + 10
			while espEnabled and characterVersions[targetPlayer] == version and targetPlayer.Character == character and character.Parent == nil and os.clock() < deadline do
				task.wait()
			end
			if espEnabled and characterVersions[targetPlayer] == version and targetPlayer.Character == character then
				syncPlayer(targetPlayer)
			end
		end)
	
		syncPlayer(targetPlayer)
	end
	
	local function disconnectPlayer(targetPlayer)
		local connections = playerConnections[targetPlayer]
		if connections then
			for _, connection in ipairs(connections) do
				connection:Disconnect()
			end
			playerConnections[targetPlayer] = nil
		end
		characterVersions[targetPlayer] = nil
		destroyHighlight(targetPlayer)
	end
	
	local function connectPlayer(targetPlayer)
		if targetPlayer == localPlayer then
			return
		end
	
		disconnectPlayer(targetPlayer)
		local connections = {}
		playerConnections[targetPlayer] = connections
	
		connections[#connections + 1] = targetPlayer.CharacterAdded:Connect(function(character)
			watchCharacter(targetPlayer, character)
		end)
	
		connections[#connections + 1] = targetPlayer.CharacterRemoving:Connect(function(character)
			if targetPlayer.Character ~= character then
				return
			end
			characterVersions[targetPlayer] = (characterVersions[targetPlayer] or 0) + 1
			destroyHighlight(targetPlayer)
		end)
	
		connections[#connections + 1] = targetPlayer:GetPropertyChangedSignal("Team"):Connect(function()
			syncPlayer(targetPlayer)
		end)
	
		if targetPlayer.Character then
			watchCharacter(targetPlayer, targetPlayer.Character)
		end
	end
	
	local function startReconciliation()
		if reconcileConnection then
			return
		end
	
		reconcileAccumulator = 0
		reconcileConnection = RunService.Heartbeat:Connect(function(deltaTime)
			reconcileAccumulator += deltaTime
		if reconcileAccumulator < 0.5 then
			return
		end
		reconcileAccumulator = 0
		if espEnabled then
			syncAllPlayers()
		end
		end)
	end
	
	local function stopReconciliation()
		if reconcileConnection then
			reconcileConnection:Disconnect()
			reconcileConnection = nil
		end
	end
	
	for _, targetPlayer in ipairs(Players:GetPlayers()) do
		connectPlayer(targetPlayer)
	end
	
	Players.PlayerAdded:Connect(connectPlayer)
	Players.PlayerRemoving:Connect(disconnectPlayer)
	
	button.MouseButton1Click:Connect(function()
		espEnabled = not espEnabled
		button:SetAttribute("Toggled", espEnabled)
		button.Text = espEnabled and "II" or "▶"
	
		if espEnabled then
			startReconciliation()
			syncAllPlayers()
			print("[ESP] Enabled")
		else
			stopReconciliation()
			destroyAllHighlights()
			print("[ESP] Disabled")
		end
	end)
end;
