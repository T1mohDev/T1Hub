			if not isTabButton then
				tweenButtonColor(button, getHoverColor(button), HOVER_INFO)
			end
			tweenScale(button, SCALE_HOVER, HOVER_INFO)
			local stroke = button:FindFirstChildOfClass("UIStroke")
			if stroke then
				tweenStrokeTransparency(button, math.max(0, getBaseStrokeTransparency(stroke) - STROKE_HOVER_DELTA), HOVER_INFO)
			end
		end)
	
		button.MouseLeave:Connect(function()
