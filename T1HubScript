		else
			showButtonStatus(copyJobIdButton, "JobId скопирован", 3)
		end
	end)
	
	local function isValidJobId(jobId)
		return string.match(jobId, "^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$") ~= nil
	end
	
	joinByJobIdButton.Activated:Connect(function()
		local jobId = string.gsub(joinByJobIdBox.Text, "^%s*(.-)%s*$", "%1")
		if jobId == "" then
			joinByJobIdBox.Text = "Введите JobId"
			return
		end
		if not isValidJobId(jobId) then
			joinByJobIdBox.Text = "Некорректный JobId"
			return
		end
	
		teleportSafely(function()
			TeleportService:TeleportToPlaceInstance(game.PlaceId, jobId, player)
		end, "Не удалось подключиться по JobId")
	end)
	
	local function applyCharacterSize(size)
		local character = player.Character
		if not character or not character.Parent then
			return false
		end
	
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			return false
		end
	
		local currentScale = character:GetScale()
		if currentScale <= 0 then
			return false
		end
	
		local ok = pcall(function()
			character:ScaleTo(size)
		end)
		if not ok then
			return false
		end
	
		for _, scaleName in { "BodyHeightScale", "BodyWidthScale", "BodyDepthScale", "HeadScale" } do
			local scaleValue = humanoid:FindFirstChild(scaleName)
			if scaleValue and scaleValue:IsA("NumberValue") then
				scaleValue.Value = size
			end
		end
	
		return true
	end
	
	local function readCharacterSize()
		local text = string.gsub(characterSizeBox.Text, "^%s*(.-)%s*$", "%1")
		local value = tonumber(text)
		if not value then
			return nil
		end
		return math.clamp(value, 0.1, 10)
	end
	
	local function applyCharacterSizeFromBox()
		local value = readCharacterSize()
		if not value then
			return
		end
		characterSizeBox.Text = tostring(value)
		lastCharacterSize = value
		if not applyCharacterSize(value) then
			showButtonStatus(clickTeleportButton, "Персонаж не готов", 2)
		end
	end
	
	characterSizeBox.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			applyCharacterSizeFromBox()
		end
	end)
	
	local function applyFov()
		local text = string.gsub(fovBox.Text, "^%s*(.-)%s*$", "%1")
		local value = tonumber(text)
		if not value then
			return
		end
		value = math.clamp(value, 30, 120)
		fovBox.Text = tostring(value)
		local camera = workspace.CurrentCamera
		if camera then
			camera.FieldOfView = value
		end
		if typeof(_G.SetFOV) == "function" then
			_G.SetFOV(value)
		end
	end
	
	fovBox.FocusLost:Connect(function()
		applyFov()
	end)
	
	local function applyFovWhileTyping()
		if fovBox:IsFocused() then
			applyFov()
		end
	end
	
	fovBox:GetPropertyChangedSignal("Text"):Connect(applyFovWhileTyping)
	
	player.CharacterAdded:Connect(function(character)
		if clickTeleportEnabled then
			setClickTeleport(false)
		end
		if lastCharacterSize then
			task.spawn(function()
				local humanoid = character:WaitForChild("Humanoid", 5)
				if humanoid then
					task.wait(0.2)
					applyCharacterSize(lastCharacterSize)
				end
			end)
		end
	end)
