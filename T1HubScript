	local function getSpectatorPlayers()
		local availablePlayers = {}
		for _, otherPlayer in Players:GetPlayers() do
			if otherPlayer ~= player then
				table.insert(availablePlayers, otherPlayer)
			end
		end
		table.sort(availablePlayers, function(firstPlayer, secondPlayer)
			return string.lower(firstPlayer.Name) < string.lower(secondPlayer.Name)
		end)
		return availablePlayers
	end
	
	local function setSpectatorCamera(targetPlayer)
		local camera = workspace.CurrentCamera
		if not camera then
			return false
		end
	
		local character = targetPlayer and targetPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			return false
		end
	
		camera.CameraType = Enum.CameraType.Custom
		camera.CameraSubject = humanoid
		spectatorTarget = targetPlayer
		playerNameLabel.Text = targetPlayer.DisplayName .. " (" .. targetPlayer.Name .. ")"
		return true
	end
	
	local function refreshSpectatorPlayers()
		spectatorPlayers = getSpectatorPlayers()
		if #spectatorPlayers == 0 then
			spectatorIndex = 0
			playerNameLabel.Text = "Нет других игроков"
			return false
		end
	
		if spectatorTarget then
			for index, targetPlayer in spectatorPlayers do
				if targetPlayer == spectatorTarget then
					spectatorIndex = index
					break
				end
			end
		end
	
		if spectatorIndex < 1 or spectatorIndex > #spectatorPlayers then
			spectatorIndex = 1
		end
		return true
	end
	
	local function spectateAtIndex(index)
		if not spectatorEnabled then
			return
		end
		if not refreshSpectatorPlayers() then
			return
		end
	
		spectatorIndex = ((index - 1) % #spectatorPlayers) + 1
		local targetPlayer = spectatorPlayers[spectatorIndex]
		if not setSpectatorCamera(targetPlayer) then
			playerNameLabel.Text = targetPlayer.DisplayName .. " (ожидание персонажа)"
		end
	end
	
	local function positionSpectatorFrameAtBottom()
		local horizontalScale = specFrame.Position.X.Scale
		local horizontalOffset = specFrame.Position.X.Offset
		local bottomMargin = 48
		local halfHeight = specFrame.AbsoluteSize.Y * 0.5
		if halfHeight <= 0 then
			halfHeight = specFrame.Size.Y.Offset * 0.5
		end
	
		specFrame.AnchorPoint = Vector2.new(0, 0.5)
		specFrame.Position = UDim2.new(horizontalScale, horizontalOffset, 1, -(halfHeight + bottomMargin))
	end
	
	local function startSpectating()
		if spectatorEnabled then
			return
		end
	
		spectatorEnabled = true
		positionSpectatorFrameAtBottom()
		specFrame.Visible = true
		spectatorTarget = nil
		spectatorIndex = 1
		spectateAtIndex(spectatorIndex)
	end
	
	local function stopSpectating()
		if not spectatorEnabled then
			specFrame.Visible = false
			return
		end
	
		spectatorEnabled = false
		spectatorTarget = nil
		spectatorPlayers = {}
		spectatorIndex = 0
		specFrame.Visible = false
	
