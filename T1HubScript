	local function getSpectatorPlayers()
		local availablePlayers = {}
		for _, otherPlayer in Players:GetPlayers() do
			if otherPlayer ~= player then
				table.insert(availablePlayers, otherPlayer)
			end
		end
		table.sort(availablePlayers, function(firstPlayer, secondPlayer)
			return string.lower(firstPlayer.Name) < string.lower(secondPlayer.Name)
		end)
		return availablePlayers
	end
	
	local function setSpectatorCamera(targetPlayer)
		local camera = workspace.CurrentCamera
		if not camera then
			return false
		end
	
		local character = targetPlayer and targetPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			return false
		end
	
		camera.CameraType = Enum.CameraType.Custom
		camera.CameraSubject = humanoid
		spectatorTarget = targetPlayer
		playerNameLabel.Text = targetPlayer.DisplayName .. " (" .. targetPlayer.Name .. ")"
		return true
	end
	
	local function refreshSpectatorPlayers()
		spectatorPlayers = getSpectatorPlayers()
		if #spectatorPlayers == 0 then
			spectatorIndex = 0
			playerNameLabel.Text = "Нет других игроков"
			return false
		end
	
		if spectatorTarget then
			for index, targetPlayer in spectatorPlayers do
				if targetPlayer == spectatorTarget then
					spectatorIndex = index
					break
				end
			end
		end
	
		if spectatorIndex < 1 or spectatorIndex > #spectatorPlayers then
			spectatorIndex = 1
		end
		return true
	end
	
	local function spectateAtIndex(index)
		if not spectatorEnabled then
			return
		end
		if not refreshSpectatorPlayers() then
			return
		end
	
		spectatorIndex = ((index - 1) % #spectatorPlayers) + 1
		local targetPlayer = spectatorPlayers[spectatorIndex]
		if not setSpectatorCamera(targetPlayer) then
			playerNameLabel.Text = targetPlayer.DisplayName .. " (ожидание персонажа)"
		end
	end
	
	local function positionSpectatorFrameAtBottom()
		local horizontalScale = specFrame.Position.X.Scale
		local horizontalOffset = specFrame.Position.X.Offset
		local bottomMargin = 48
		local halfHeight = specFrame.AbsoluteSize.Y * 0.5
		if halfHeight <= 0 then
			halfHeight = specFrame.Size.Y.Offset * 0.5
		end
	
		specFrame.AnchorPoint = Vector2.new(0, 0.5)
		specFrame.Position = UDim2.new(horizontalScale, horizontalOffset, 1, -(halfHeight + bottomMargin))
	end
	
	local function startSpectating()
		if spectatorEnabled then
			return
		end
	
		spectatorEnabled = true
		positionSpectatorFrameAtBottom()
		specFrame.Visible = true
		spectatorTarget = nil
		spectatorIndex = 1
		spectateAtIndex(spectatorIndex)
	end
	
	local function stopSpectating()
		if not spectatorEnabled then
			specFrame.Visible = false
			return
		end
	
		spectatorEnabled = false
		spectatorTarget = nil
		spectatorPlayers = {}
		spectatorIndex = 0
		specFrame.Visible = false
	
		local camera = workspace.CurrentCamera
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if camera then
			camera.CameraType = Enum.CameraType.Custom
			if humanoid then
				camera.CameraSubject = humanoid
			end
		end
	end
	
	specPlayersButton.Activated:Connect(startSpectating)
	nextPlayerButton.Activated:Connect(function()
		spectateAtIndex(spectatorIndex + 1)
	end)
	previousPlayerButton.Activated:Connect(function()
		spectateAtIndex(spectatorIndex - 1)
	end)
	exitSpectatorButton.Activated:Connect(stopSpectating)
	
	local function watchSpectatorCharacter(targetPlayer)
		targetPlayer.CharacterAdded:Connect(function()
			if spectatorEnabled and spectatorTarget == targetPlayer then
				task.defer(function()
					if spectatorEnabled and spectatorTarget == targetPlayer then
						setSpectatorCamera(targetPlayer)
					end
				end)
			end
		end)
	end
	
	for _, otherPlayer in Players:GetPlayers() do
		if otherPlayer ~= player then
			watchSpectatorCharacter(otherPlayer)
		end
	end
	
	Players.PlayerAdded:Connect(function(otherPlayer)
		if otherPlayer ~= player then
			watchSpectatorCharacter(otherPlayer)
		end
		if spectatorEnabled then
			spectatorPlayers = getSpectatorPlayers()
		end
	end)
	
	Players.PlayerRemoving:Connect(function(leavingPlayer)
		if not spectatorEnabled then
			return
		end
		if leavingPlayer == spectatorTarget then
			spectatorTarget = nil
			task.defer(function()
				if spectatorEnabled then
					spectateAtIndex(spectatorIndex)
				end
			end)
		else
			spectatorPlayers = getSpectatorPlayers()
		end
	end)
	
	player.CharacterAdded:Connect(function(character)
		if spectatorEnabled and spectatorTarget == player then
			task.defer(function()
				local humanoid = character:WaitForChild("Humanoid", 5)
				if humanoid and spectatorEnabled then
					local camera = workspace.CurrentCamera
					if camera then
						camera.CameraSubject = humanoid
					end
				end
			end)
		end
	end)
	
	UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
		if not clickTeleportEnabled then
			return
		end
	
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			local mouseLocation = UserInputService:GetMouseLocation()
			local buttonPosition = clickTeleportButton.AbsolutePosition + GuiService:GetGuiInset()
			local buttonSize = clickTeleportButton.AbsoluteSize
			local insideButton = mouseLocation.X >= buttonPosition.X
				and mouseLocation.X <= buttonPosition.X + buttonSize.X
				and mouseLocation.Y >= buttonPosition.Y
				and mouseLocation.Y <= buttonPosition.Y + buttonSize.Y
			if insideButton then
				return
			end
			teleportToMouse(mouseLocation)
		elseif input.UserInputType == Enum.UserInputType.Touch then
			teleportToMouse(input.Position)
		end
	end)
	
	local function teleportSafely(callback, errorText)
		local ok, err = pcall(callback)
		if not ok then
			warn("[ServerToolsScript] " .. errorText .. ": " .. tostring(err))
			return false
		end
		return true
	end
	
	rejoinButton.Activated:Connect(function()
		teleportSafely(function()
			TeleportService:Teleport(game.PlaceId, player)
		end, "Не удалось выполнить rejoin")
	end)
	
	local function tryCopyToClipboard(text)
		local copied = false
		local ok = pcall(function()
			if typeof(setclipboard) == "function" then
				setclipboard(text)
				copied = true
			end
		end)
		return ok and copied
	end
	
	copyJobIdButton.Activated:Connect(function()
		local jobId = game.JobId
		if jobId == "" then
			joinByJobIdBox.Text = "JobId недоступен в Studio"
			showButtonStatus(copyJobIdButton, "JobId недоступен", 3)
			return
		end
	
		local copied = tryCopyToClipboard(jobId)
		if not copied then
			joinByJobIdBox.Text = jobId
			showButtonStatus(copyJobIdButton, "▶", 3)
		else
			showButtonStatus(copyJobIdButton, "▶", 3)
		end
	end)
	
	local function isValidJobId(jobId)
		return string.match(jobId, "^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$") ~= nil
	end
	
	joinByJobIdButton.Activated:Connect(function()
		local jobId = string.gsub(joinByJobIdBox.Text, "^%s*(.-)%s*$", "%1")
		if jobId == "" then
			joinByJobIdBox.Text = "Введите JobId"
			return
		end
		if not isValidJobId(jobId) then
			joinByJobIdBox.Text = "Некорректный JobId"
			return
		end
	
		teleportSafely(function()
			TeleportService:TeleportToPlaceInstance(game.PlaceId, jobId, player)
		end, "Не удалось подключиться по JobId")
	end)
	
	local function applyCharacterSize(size)
		local character = player.Character
		if not character or not character.Parent then
			return false
		end
	
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			return false
		end
	
		local currentScale = character:GetScale()
		if currentScale <= 0 then
			return false
		end
	
		local ok = pcall(function()
			character:ScaleTo(size)
		end)
		if not ok then
			return false
		end
	
		for _, scaleName in { "BodyHeightScale", "BodyWidthScale", "BodyDepthScale", "HeadScale" } do
			local scaleValue = humanoid:FindFirstChild(scaleName)
			if scaleValue and scaleValue:IsA("NumberValue") then
				scaleValue.Value = size
			end
		end
	
		return true
	end
	
	local function readCharacterSize()
		local text = string.gsub(characterSizeBox.Text, "^%s*(.-)%s*$", "%1")
		local value = tonumber(text)
		if not value then
			return nil
		end
		return math.clamp(value, 0.1, 10)
	end
	
	local function applyCharacterSizeFromBox()
		local value = readCharacterSize()
		if not value then
			return
		end
		characterSizeBox.Text = tostring(value)
		lastCharacterSize = value
		if not applyCharacterSize(value) then
			showButtonStatus(clickTeleportButton, "▶", 2)
		end
	end
	
	characterSizeBox.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			applyCharacterSizeFromBox()
		end
	end)
	
	local function applyFov()
		local text = string.gsub(fovBox.Text, "^%s*(.-)%s*$", "%1")
		local value = tonumber(text)
		if not value then
			return
		end
		fovBox.Text = tostring(value)
		local camera = workspace.CurrentCamera
		if camera then
			camera.FieldOfView = value
		end
		if typeof(_G.SetFOV) == "function" then
			_G.SetFOV(value)
		end
	end
	
	fovBox.FocusLost:Connect(function()
		applyFov()
	end)
	
	local function applyFovWhileTyping()
		if fovBox:IsFocused() then
			applyFov()
		end
	end
	
	fovBox:GetPropertyChangedSignal("Text"):Connect(applyFovWhileTyping)
	
	player.CharacterAdded:Connect(function(character)
		if freeCamEnabled then
			stopFreeCam()
		end
		if clickTeleportEnabled then
			setClickTeleport(false)
		end
		if lastCharacterSize then
			task.spawn(function()
				local humanoid = character:WaitForChild("Humanoid", 5)
				if humanoid then
					task.wait(0.2)
					applyCharacterSize(lastCharacterSize)
				end
			end)
		end
	end)
end;
