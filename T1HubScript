		if animation and originalAnimationIds[animation] == nil then
			originalAnimationIds[animation] = animation.AnimationId
		end
	end
	
	local function setAnimationId(containerName, animationName, animationId)
		if not animateScript then
			return
		end
	
		local container = animateScript:FindFirstChild(containerName)
		local animation = findAnimation(container, animationName)
		if not animation then
			return
		end
	
		saveOriginalAnimation(animation)
		animation.AnimationId = animationId
	end
	
