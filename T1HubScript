			if h then h:Destroy(); highlights[p] = nil end
			_roles[p] = nil
			_dead[p] = nil
		end)
	
		task.spawn(function()
			task.wait(2)
			refresh()
			while true do
				task.wait(2)
				refresh()
			end
		end)
	
		LP.CharacterAdded:Connect(function() task.wait(1) refresh() end)
	end
	
