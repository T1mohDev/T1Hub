		local base = obj:GetAttribute("AnimBaseColor3")
		if base == nil then
			base = obj.BackgroundColor3
			obj:SetAttribute("AnimBaseColor3", base)
		end
		return base
	end
	
	local function getBaseStrokeTransparency(stroke)
		local base = stroke:GetAttribute("AnimBaseStrokeTransparency")
		if base == nil then
			base = stroke.Transparency
			stroke:SetAttribute("AnimBaseStrokeTransparency", base)
		end
		return base
	end
	
	local function getBaseStrokeColor(stroke)
