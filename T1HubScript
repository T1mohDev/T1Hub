local function C_15e()
local script = G2L["15e"];
	-- Вставь этот скрипт внутрь кнопки NextSovet (в LocalScript)
	
	local button = script.Parent
	
	-- Путь до текста с советами (TextLabel, который называется "tip")
	local tipLabel = button.Parent:WaitForChild("tip") 
	
	-- ТВОИ СОВЕТЫ ИЗ ФАЙЛА
	local tips = {
		"Нажми RightAlt, чтобы скрыть или открыть скрипт",
		"Автор скрипта: T1mohD3v",
		"Если не нравится освещение в игре используй шейдеры",
		"Скоро мы добавим автофарм монет в мм2"
	}
	
	-- ================= НАСТРОЙКИ =================
	local TYPE_TIME = 1.5    -- Время печати нового совета (сек)
	local ERASE_TIME = 0.5   -- Время стирания старого совета (сек) - сделал быстрее для отзывчивости
	local CURSOR = "_"       -- Символ курсора
	-- =============================================
	
	local queue = {}
	local lastTip = nil
	local isAnimating = false
	
	-- Получаем рандомный совет без повторов
	local function getNextTip()
		if #queue == 0 then
			for _, tip in ipairs(tips) do
				table.insert(queue, tip)
			end
			for i = #queue, 2, -1 do
				local j = math.random(i)
				queue[i], queue[j] = queue[j], queue[i]
			end
			if queue[1] == lastTip and #queue > 1 then
				queue[1], queue[2] = queue[2], queue[1]
			end
		end
	
		local nextTip = table.remove(queue, 1)
		lastTip = nextTip
		return nextTip
	end
	
	-- Эффект печати
	local function typeText(text, duration)
		local totalChars = string.len(text)
		if totalChars == 0 then return end
		local delayPerChar = duration / totalChars
	
		tipLabel.Text = CURSOR
		for i = 1, totalChars do
			tipLabel.Text = string.sub(text, 1, i) .. CURSOR
			task.wait(delayPerChar)
		end
		tipLabel.Text = text .. CURSOR
	end
	
	-- Эффект стирания (обратная печать)
	local function eraseText(duration)
		local currentText = tipLabel.Text:gsub(CURSOR, "") -- Убираем курсор, чтобы правильно посчитать буквы
		local totalChars = string.len(currentText)
	
		if totalChars == 0 then
			tipLabel.Text = CURSOR
			return
		end
	
		local delayPerChar = duration / totalChars
	
		for i = totalChars, 1, -1 do
			tipLabel.Text = string.sub(currentText, 1, i) .. CURSOR
			task.wait(delayPerChar)
		end
		tipLabel.Text = CURSOR
	end
	
	-- Обработка клика по кнопке NextSovet
	button.MouseButton1Click:Connect(function()
		-- Если уже идет стирание или печать — игнорируем клики, чтобы не сломать анимацию
		if isAnimating then return end 
	
		isAnimating = true
	
		-- 1. Сначала плавно стираем то, что есть
		eraseText(ERASE_TIME)
	
		-- 2. Ждем чуть-чуть и печатаем новый
		local newTip = getNextTip()
		typeText(newTip, TYPE_TIME)
	
		isAnimating = false
	end)
	
	-- Вывести первый совет сразу при загрузке (без стирания, так как текста еще нет)
	task.spawn(function()
		task.wait(0.5)
		if tipLabel.Text == "" or tipLabel.Text == "tip" then
			isAnimating = true
			typeText(getNextTip(), TYPE_TIME)
			isAnimating = false
		end
	end)
end;
