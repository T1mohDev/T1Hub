	local function teleportToMouse(screenPosition)
		local character, root = getCharacterRoot()
		if not character or not root then
			showButtonStatus(clickTeleportButton, "Персонаж не готов", 2)
			return
		end
	
		local camera = workspace.CurrentCamera
		if not camera then
			showButtonStatus(clickTeleportButton, "Камера недоступна", 2)
			return
		end
	
		local inset = GuiService:GetGuiInset()
		local ray = camera:ViewportPointToRay(screenPosition.X - inset.X, screenPosition.Y - inset.Y)
		local raycastParams = RaycastParams.new()
		raycastParams.FilterType = Enum.RaycastFilterType.Exclude
		raycastParams.FilterDescendantsInstances = { character }
		local result = workspace:Raycast(ray.Origin, ray.Direction * 2000, raycastParams)
		if not result then
			showButtonStatus(clickTeleportButton, "Место не найдено", 2)
			return
		end
	
		local currentPivot = character:GetPivot()
		local lift = math.max(root.Size.Y * 0.5, 2)
		character:PivotTo(CFrame.new(result.Position + Vector3.new(0, lift, 0)) * currentPivot.Rotation)
	end
	
