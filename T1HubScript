	-- ============================================================
	-- Кнопка: Телепорт к Шерифу или Герою (одноразовый клик)
	-- Приоритет: Шериф → если нет живого, Герой
	-- ============================================================
	local btn = script.Parent
	
	local function isAlive(player)
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		return hum and hum.Health > 0
	end
	
	local function findSheriffOrHero()
		if not _G.RE or not _G.RE.roles then return nil, nil end
	
		local sheriff, hero
		for player, role in pairs(_G.RE.roles) do
			if not player.Parent then continue end
			if not isAlive(player) then continue end
	
			if role == "Sheriff" and not sheriff then
				sheriff = player
			elseif role == "Hero" and not hero then
				hero = player
			end
		end
	
		if sheriff then return sheriff, "Sheriff" end
		if hero then return hero, "Hero" end
		return nil, nil
	end
	
	btn.Text = "Тп к шериф/герой"
	
	btn.MouseButton1Click:Connect(function()
		local target, role = findSheriffOrHero()
		if not target then
			btn.Text = "Никого не найдено"
			task.wait(1.5)
			btn.Text = "Тп к шериф/герой"
			return
		end
	
		local lp = game.Players.LocalPlayer
		local myHrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
		local targetHrp = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
	
		if not myHrp or not targetHrp then
			btn.Text = "Ошибка"
			task.wait(1.5)
			btn.Text = "Тп к шериф/герой"
			return
		end
	
		myHrp.CFrame = targetHrp.CFrame * CFrame.new(0, 0, 3)
	
		local icon = role == "Sheriff" and "🔵" or "🟡"
		btn.Text = "✅ " .. icon .. " → " .. target.Name
		task.wait(1.5)
		btn.Text = "Тп к шериф/герой"
	end)
end;
