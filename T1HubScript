-- StarterGui.T1Hub.FrameMain.Frame6.Frame8.logscript
local function C_cf()
local script = G2L["cf"];
	-- ============================================================
	-- PLAYER CHAT LOG v3 — только сообщения от игроков
	-- Вставь в LocalScript внутри Frame во вкладке "Инфо"
	-- ============================================================
	
	local Players = game:GetService("Players")
	local TextChatService = game:GetService("TextChatService")
	
	local parentFrame = script.Parent
	
	-- ============================================================
	-- НАСТРОЙКИ
	-- ============================================================
	local MAX_LOG = 200                   -- максимум сообщений в памяти
	local SHOW_SYSTEM = false             -- показывать системные сообщения
	local SHOW_TIMESTAMP = true           -- показывать время [HH:MM]
	local COLOR_PLAYER = Color3.fromRGB(220, 220, 240)   -- цвет сообщений игроков
	local COLOR_SYSTEM = Color3.fromRGB(130, 130, 145)   -- цвет системных
	local COLOR_NICK   = Color3.fromRGB(99, 102, 241)    -- цвет ника (фиолетовый)
	local COLOR_BG     = Color3.fromRGB(20, 20, 24)      -- фон окна
	local COLOR_TITLE  = Color3.fromRGB(236, 239, 246)   -- цвет заголовка
	
	-- ============================================================
	-- УТИЛИТЫ
	-- ============================================================
	
	-- Убирает все <font>, </font>, <b>, <i> и прочие rich-text теги
	local function stripRichText(text)
		if not text then return "" end
		text = string.gsub(text, "<.->", "")
		text = string.gsub(text, "&amp;", "&")
		text = string.gsub(text, "&lt;", "<")
		text = string.gsub(text, "&gt;", ">")
		text = string.gsub(text, "&quot;", "\"")
		text = string.gsub(text, "&apos;", "'")
		text = string.gsub(text, "&nbsp;", " ")
		return text
	end
	
	-- Проверяем, сообщение от игрока или системное
	local function isPlayerMessage(message)
		if not message.TextSource then return false end
		if not message.TextSource.UserId then return false end
		if message.TextSource.UserId == 0 then return false end
		return true
	end
	
	-- Получаем имя игрока
	local function getPlayerName(message)
		local player = Players:GetPlayerByUserId(message.TextSource.UserId)
		if player then
			return player.DisplayName, player.Name
		end
		return message.TextSource.Name or "Unknown", "Unknown"
	end
	
	-- ============================================================
	-- СОЗДАНИЕ UI
	-- ============================================================
	local container = parentFrame:FindFirstChild("PlayerChatLog")
	if not container then
		container = Instance.new("Frame")
		container.Name = "PlayerChatLog"
		container.Size = UDim2.new(1, -20, 1, -20)
		container.Position = UDim2.new(0, 10, 0, 10)
		container.BackgroundColor3 = COLOR_BG
		container.BorderSizePixel = 0
		container.Parent = parentFrame
	
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, 10)
		c.Parent = container
	
		local stroke = Instance.new("UIStroke")
		stroke.Color = Color3.fromRGB(51, 52, 59)
		stroke.Transparency = 0.12
		stroke.Parent = container
	end
	
	-- Заголовок
	local header = container:FindFirstChild("Header")
	if not header then
		header = Instance.new("Frame")
		header.Name = "Header"
		header.Size = UDim2.new(1, 0, 0, 40)
		header.BackgroundTransparency = 1
		header.Parent = container
	
		local title = Instance.new("TextLabel")
		title.Size = UDim2.new(1, -110, 1, 0)
		title.Position = UDim2.new(0, 12, 0, 0)
		title.BackgroundTransparency = 1
		title.Text = "💬 Сообщения игроков"
		title.TextColor3 = COLOR_TITLE
		title.Font = Enum.Font.GothamBold
		title.TextSize = 15
		title.TextXAlignment = Enum.TextXAlignment.Left
		title.Parent = header
	
		-- Счётчик
		local counter = Instance.new("TextLabel")
		counter.Name = "Counter"
		counter.Size = UDim2.new(0, 80, 1, 0)
		counter.Position = UDim2.new(1, -180, 0, 0)
		counter.BackgroundTransparency = 1
		counter.Text = "0 сообщений"
		counter.TextColor3 = Color3.fromRGB(150, 150, 170)
		counter.Font = Enum.Font.GothamMedium
		counter.TextSize = 12
		counter.TextXAlignment = Enum.TextXAlignment.Right
		counter.Parent = header
	
		-- Кнопка очистки
		local clear = Instance.new("TextButton")
		clear.Name = "Clear"
		clear.Size = UDim2.new(0, 60, 0, 24)
		clear.Position = UDim2.new(1, -70, 0, 8)
		clear.BackgroundColor3 = Color3.fromRGB(60, 30, 30)
		clear.BorderSizePixel = 0
		clear.Text = "Очистить"
		clear.TextColor3 = Color3.fromRGB(255, 200, 200)
		clear.Font = Enum.Font.GothamMedium
		clear.TextSize = 11
		clear.AutoButtonColor = false
		clear.Parent = header
	
		local cc = Instance.new("UICorner")
		cc.CornerRadius = UDim.new(0, 6)
		cc.Parent = clear
	end
	
	-- ScrollingFrame со списком
	local scroll = container:FindFirstChild("Scroll")
	if not scroll then
		scroll = Instance.new("ScrollingFrame")
		scroll.Name = "Scroll"
		scroll.Size = UDim2.new(1, -20, 1, -50)
		scroll.Position = UDim2.new(0, 10, 0, 45)
		scroll.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
		scroll.BorderSizePixel = 0
		scroll.ScrollBarThickness = 5
		scroll.ScrollBarImageColor3 = Color3.fromRGB(99, 102, 241)
		scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
		scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
		scroll.ScrollingDirection = Enum.ScrollingDirection.Y
		scroll.Parent = container
	
		local sc = Instance.new("UICorner")
		sc.CornerRadius = UDim.new(0, 6)
		sc.Parent = scroll
	
		local list = Instance.new("UIListLayout")
		list.SortOrder = Enum.SortOrder.LayoutOrder
		list.Padding = UDim.new(0, 3)
		list.Parent = scroll
	
		local pad = Instance.new("UIPadding")
		pad.PaddingTop = UDim.new(0, 6)
		pad.PaddingBottom = UDim.new(0, 6)
		pad.PaddingLeft = UDim.new(0, 8)
		pad.PaddingRight = UDim.new(0, 8)
		pad.Parent = scroll
	end
	
	-- ============================================================
	-- ЛОГИКА ДОБАВЛЕНИЯ
	-- ============================================================
	local messageCount = 0
	
	local function updateCounter()
		local counter = container.Header:FindFirstChild("Counter")
		if counter then
			counter.Text = messageCount .. " сообщений"
		end
	end
	
	local function addMessage(sender, text, isSystem)
		if not scroll or not scroll.Parent then return end
	
		-- Обрезаем очень длинные сообщения
		if #text > 200 then
			text = string.sub(text, 1, 200) .. "..."
		end
	
		-- Создаём контейнер строки
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0, 18)
		row.BackgroundTransparency = 1
		row.Parent = scroll
	
		-- Время
		local xOffset = 0
		if SHOW_TIMESTAMP then
			local timeLabel = Instance.new("TextLabel")
			timeLabel.Size = UDim2.new(0, 42, 1, 0)
			timeLabel.Position = UDim2.new(0, 0, 0, 0)
			timeLabel.BackgroundTransparency = 1
			timeLabel.Text = os.date("%H:%M")
			timeLabel.TextColor3 = Color3.fromRGB(110, 110, 130)
			timeLabel.Font = Enum.Font.Gotham
			timeLabel.TextSize = 12
			timeLabel.TextXAlignment = Enum.TextXAlignment.Left
			timeLabel.Parent = row
			xOffset = 46
		end
	
		-- Пометка системного
		if isSystem then
			local sysLabel = Instance.new("TextLabel")
			sysLabel.Size = UDim2.new(0, 40, 1, 0)
			sysLabel.Position = UDim2.new(0, xOffset, 0, 0)
			sysLabel.BackgroundTransparency = 1
			sysLabel.Text = "[SYS]"
			sysLabel.TextColor3 = Color3.fromRGB(200, 100, 100)
			sysLabel.Font = Enum.Font.GothamBold
			sysLabel.TextSize = 11
			sysLabel.TextXAlignment = Enum.TextXAlignment.Left
			sysLabel.Parent = row
			xOffset = xOffset + 42
		end
	
		-- Ник
		if sender and sender ~= "" then
			local nickLabel = Instance.new("TextLabel")
			nickLabel.Size = UDim2.new(0, 130, 1, 0)
			nickLabel.Position = UDim2.new(0, xOffset, 0, 0)
			nickLabel.BackgroundTransparency = 1
			nickLabel.Text = sender .. ":"
			nickLabel.TextColor3 = isSystem and COLOR_SYSTEM or COLOR_NICK
			nickLabel.Font = Enum.Font.GothamBold
			nickLabel.TextSize = 12
			nickLabel.TextXAlignment = Enum.TextXAlignment.Left
			nickLabel.TextTruncate = Enum.TextTruncate.AtEnd
			nickLabel.Parent = row
			xOffset = xOffset + 132
		end
	
		-- Текст
		local textLabel = Instance.new("TextLabel")
		textLabel.Size = UDim2.new(1, -xOffset, 1, 0)
		textLabel.Position = UDim2.new(0, xOffset, 0, 0)
		textLabel.BackgroundTransparency = 1
		textLabel.Text = text
		textLabel.TextColor3 = isSystem and COLOR_SYSTEM or COLOR_PLAYER
		textLabel.Font = Enum.Font.Gotham
		textLabel.TextSize = 12
		textLabel.TextXAlignment = Enum.TextXAlignment.Left
		textLabel.TextTruncate = Enum.TextTruncate.AtEnd
		textLabel.Parent = row
	
		messageCount = messageCount + 1
		updateCounter()
	
		-- Ограничиваем количество
		local allRows = {}
		for _, c in ipairs(scroll:GetChildren()) do
			if c:IsA("Frame") then table.insert(allRows, c) end
		end
	
		if #allRows > MAX_LOG then
			allRows[1]:Destroy()
			messageCount = messageCount - 1
			updateCounter()
		end
	
		-- Автоскролл вниз
		task.defer(function()
			scroll.CanvasPosition = Vector2.new(0, scroll.AbsoluteCanvasSize.Y)
		end)
	end
	
	-- ============================================================
	-- ОБРАБОТКА СООБЩЕНИЙ
	-- ============================================================
	local function handleMessage(message)
		-- Системное?
		if not isPlayerMessage(message) then
			if not SHOW_SYSTEM then return end
			local clean = stripRichText(message.Text)
			if clean == "" then return end
			addMessage("", clean, true)
			return
		end
	
		-- Сообщение от игрока
		local displayName = getPlayerName(message)
		local clean = stripRichText(message.Text)
		if clean == "" then return end
	
		addMessage(displayName, clean, false)
	end
	
	-- ============================================================
	-- ХУКИ НА ЧАТ
	-- ============================================================
	local function hookChannel(channel)
		channel.MessageReceived:Connect(handleMessage)
	end
	
	-- Подключаем существующие каналы
	local ok, channels = pcall(function()
		return TextChatService:WaitForChild("TextChannels", 5):GetChildren()
	end)
	
	if ok and channels then
		for _, channel in ipairs(channels) do
			if channel:IsA("TextChannel") then
				hookChannel(channel)
			end
		end
	end
	
	-- Подключаем новые каналы
	TextChatService.TextChannels.ChildAdded:Connect(function(channel)
		if channel:IsA("TextChannel") then
			hookChannel(channel)
		end
	end)
	
	-- Также пробуем старый чат (для старых версий)
	if TextChatService.ChatVersion == Enum.ChatVersion.LegacyChatService then
		local ok2, chatEvents = pcall(function()
			return game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
		end)
		if ok2 and chatEvents then
			local onMessage = chatEvents:FindFirstChild("OnMessageDoneFiltering")
			if onMessage then
				onMessage.OnClientEvent:Connect(function(data)
					if not data or not data.Message then return end
					local sender = data.FromSpeaker or "Unknown"
					if sender == "Unknown" then return end
					local clean = stripRichText(data.Message)
					if clean ~= "" then
						addMessage(sender, clean, false)
					end
				end)
			end
		end
	end
	
	-- ============================================================
	-- КНОПКА ОЧИСТКИ
	-- ============================================================
	container.Header.Clear.MouseButton1Click:Connect(function()
		for _, c in ipairs(scroll:GetChildren()) do
			if c:IsA("Frame") then c:Destroy() end
		end
		messageCount = 0
		updateCounter()
	end)
	
	print("========================================")
	print("💬 Player Chat Log v3 загружен")
	print("📝 Логируются только сообщения игроков")
	print("🚫 Системные сообщения: " .. (SHOW_SYSTEM and "видны" or "скрыты"))
	print("========================================")
end;
