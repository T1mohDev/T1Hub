	-- LEMONADE_UI_SCALE_CONVERTER disabled: was breaking pixel-based UI on
	-- different screen resolutions by rewriting Offset sizes to Scale at runtime.
	-- The converter also applied to ALL ScreenGuis in the game, not just T1Hub.
	
	local Players = game:GetService("Players")
