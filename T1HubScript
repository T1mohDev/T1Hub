	local function getCharacterAndHumanoid()
		local character = player.Character or player.CharacterAdded:Wait()
		return character, character:FindFirstChildOfClass("Humanoid"), character:FindFirstChild("HumanoidRootPart")
	end
	
	local function getUprightCFrame(currentRoot)
		local position = currentRoot.Position
		local look = currentRoot.CFrame.LookVector
		local flatLook = Vector3.new(look.X, 0, look.Z)
		if flatLook.Magnitude < 0.01 then
			flatLook = Vector3.new(0, 0, -1)
		else
			flatLook = flatLook.Unit
		end
		return CFrame.lookAt(position, position + flatLook)
	end
	
	local function leaveLay()
		local currentHumanoid = humanoid
		local currentRoot = root
		if currentRoot and currentRoot.Parent then
			currentRoot.CFrame = getUprightCFrame(currentRoot)
		end
		if currentHumanoid then
			currentHumanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
			currentHumanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
		laying = false
		button.Text = "▶"
		if player:GetAttribute(POSE_ATTRIBUTE) == POSE_NAME then
			player:SetAttribute(POSE_ATTRIBUTE, nil)
		end
	end
	
	local function enterLay()
		local character
		character, humanoid, root = getCharacterAndHumanoid()
		if not humanoid or not root or humanoid.Health <= 0 then
			return
		end
	
		player:SetAttribute(POSE_ATTRIBUTE, POSE_NAME)
		laying = true
		humanoid.Sit = false
		humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
		root.CFrame = root.CFrame * CFrame.Angles(0, 0, math.rad(90))
