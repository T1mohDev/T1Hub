local function C_90()
local script = G2L["90"];
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	
	local frame5 = script.Parent
	local playerList = frame5:FindFirstChild("FramePL")
	if not playerList then
		return
	end
	local listLayout = playerList:FindFirstChildOfClass("UIListLayout")
	if not listLayout then
		listLayout = Instance.new("UIListLayout")
		listLayout.SortOrder = Enum.SortOrder.LayoutOrder
		listLayout.Padding = UDim.new(0, 2)
		listLayout.Parent = playerList
	end
	local chosenLabel = frame5:FindFirstChild("ChoosedPlayer")
	local tpButton = frame5:FindFirstChild("Tp")
	local followButton = frame5:FindFirstChild("Follow")
	local orbitButton = frame5:FindFirstChild("Orbit")
	local trakButton = frame5:FindFirstChild("Trak")
	if not chosenLabel or not tpButton or not followButton or not orbitButton or not trakButton then
		return
	end
	local localPlayer = Players.LocalPlayer
	
	local selectedPlayer
	local followActive = false
	local orbitActive = false
	local trakActive = false
	local orbitAngle = 0
	local orbitHeight = 3
	local orbitRadius = 10
	local followDistance = 4
	local savedCollision = {}
	local playerConnections = {}
	
	local function getRoot(targetPlayer)
		local character = targetPlayer and targetPlayer.Character
		return character and character:FindFirstChild("HumanoidRootPart")
	end
	
	local function getLocalCharacter()
		local character = localPlayer.Character
		if not character then
			return nil, nil, nil
		end
		return character, character:FindFirstChildOfClass("Humanoid"), character:FindFirstChild("HumanoidRootPart")
	end
	
	local function setChosenText()
		chosenLabel.Text = selectedPlayer and ("Выбранный игрок: " .. selectedPlayer.Name) or "Выбранный игрок: нет"
	end
	
	local function restoreCollision()
		for part, canCollide in pairs(savedCollision) do
			if part and part.Parent then
				part.CanCollide = canCollide
			end
		end
		table.clear(savedCollision)
	end
	
	local function setOrbitCollision(enabled)
		local character = localPlayer.Character
		if not character then
			return
		end
		if enabled then
			table.clear(savedCollision)
			for _, object in character:GetDescendants() do
				if object:IsA("BasePart") then
					savedCollision[object] = object.CanCollide
					object.CanCollide = false
				end
			end
		else
			restoreCollision()
		end
	end
	
	local function stopModes()
		followActive = false
		orbitActive = false
		trakActive = false
		setOrbitCollision(false)
		followButton.Text = "Преследовать"
		orbitButton.Text = "Орбит"
		trakButton.Text = "Ртах"
	end
	
	local function validateSelection()
		if not selectedPlayer or selectedPlayer == localPlayer or not selectedPlayer.Parent then
			selectedPlayer = nil
			setChosenText()
			stopModes()
			return false
		end
		if not getRoot(selectedPlayer) then
			stopModes()
			return false
		end
		return true
	end
	
	local function selectPlayer(targetPlayer, targetButton)
		if selectedPlayer == targetPlayer then
			selectedPlayer = nil
		else
			stopModes()
			selectedPlayer = targetPlayer
		end
		setChosenText()
		for _, child in playerList:GetChildren() do
			if child:IsA("TextButton") then
				child.BackgroundColor3 = child == targetButton and Color3.fromRGB(50, 110, 170) or Color3.fromRGB(28, 28, 28)
			end
		end
	end
	
	local function createPlayerButton(targetPlayer)
		local targetButton = Instance.new("TextButton")
		targetButton.Name = "Player_" .. targetPlayer.UserId
		targetButton.Size = UDim2.new(1, -8, 0, 30)
		targetButton.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
		targetButton.BorderSizePixel = 0
		targetButton.TextColor3 = Color3.new(1, 1, 1)
		targetButton.Text = targetPlayer.DisplayName .. " (@" .. targetPlayer.Name .. ")"
		targetButton.TextScaled = true
		targetButton.Font = Enum.Font.SourceSans
		targetButton.LayoutOrder = targetPlayer.UserId
		targetButton.Parent = playerList
		targetButton.Activated:Connect(function()
			selectPlayer(targetPlayer, targetButton)
		end)
	end
	
	local function rebuildPlayerList()
		for _, child in playerList:GetChildren() do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
		local visiblePlayers = {}
		for _, targetPlayer in Players:GetPlayers() do
			if targetPlayer ~= localPlayer then
				table.insert(visiblePlayers, targetPlayer)
				createPlayerButton(targetPlayer)
			end
		end
		playerList.CanvasSize = UDim2.new(0, 0, 0, #visiblePlayers * 32)
		print("[PlayerActionsScript] Server players: " .. #Players:GetPlayers() .. "; list entries: " .. #visiblePlayers .. "; local player: " .. localPlayer.Name)
		for index, targetPlayer in ipairs(visiblePlayers) do
			print("[PlayerActionsScript] Entry " .. index .. ": " .. targetPlayer.Name)
		end
		if selectedPlayer and not selectedPlayer.Parent then
			selectedPlayer = nil
			setChosenText()
			stopModes()
		end
	end
	
	local function connectPlayer(targetPlayer)
		playerConnections[targetPlayer] = targetPlayer.CharacterAdded:Connect(function()
			if targetPlayer == selectedPlayer then
				stopModes()
			end
		end)
	end
	
	local function disconnectPlayer(targetPlayer)
		local connection = playerConnections[targetPlayer]
		if connection then
			connection:Disconnect()
			playerConnections[targetPlayer] = nil
		end
		if selectedPlayer == targetPlayer then
			selectedPlayer = nil
			setChosenText()
			stopModes()
		end
		rebuildPlayerList()
	end
	
	for _, targetPlayer in Players:GetPlayers() do
		if targetPlayer ~= localPlayer then
			connectPlayer(targetPlayer)
		end
	end
	Players.PlayerAdded:Connect(function(targetPlayer)
		connectPlayer(targetPlayer)
		rebuildPlayerList()
	end)
	Players.PlayerRemoving:Connect(disconnectPlayer)
	
	localPlayer.CharacterAdded:Connect(function()
		stopModes()
	end)
	
	followButton.Activated:Connect(function()
		if followActive then
			stopModes()
			return
		end
		if validateSelection() then
			orbitActive = false
			setOrbitCollision(false)
			followActive = true
			followButton.Text = "Остановить"
			orbitButton.Text = "Орбит"
		end
	end)
	
	tpButton.Activated:Connect(function()
		if not validateSelection() then
			return
		end
		local _, _, localRoot = getLocalCharacter()
		local targetRoot = getRoot(selectedPlayer)
		if localRoot and targetRoot then
			local targetPosition = targetRoot.Position - targetRoot.CFrame.LookVector * followDistance
			localRoot.CFrame = CFrame.lookAt(targetPosition + Vector3.new(0, 2, 0), targetRoot.Position)
		end
	end)
	
	orbitButton.Activated:Connect(function()
		if orbitActive then
			stopModes()
			return
		end
		if validateSelection() then
			followActive = false
			orbitActive = true
			orbitAngle = 0
			setOrbitCollision(true)
			orbitButton.Text = "Остановить"
			followButton.Text = "Преследовать"
		end
	end)
	
	RunService.RenderStepped:Connect(function(deltaTime)
		if not selectedPlayer or (not followActive and not orbitActive) then
			return
		end
		if not validateSelection() then
			return
		end
		local _, humanoid, localRoot = getLocalCharacter()
		local targetRoot = getRoot(selectedPlayer)
		if not humanoid or not localRoot or not targetRoot then
			stopModes()
			return
		end
		if followActive then
			local targetPosition = targetRoot.Position - targetRoot.CFrame.LookVector * followDistance
			local flatPosition = Vector3.new(targetPosition.X, localRoot.Position.Y, targetPosition.Z)
			localRoot.CFrame = CFrame.lookAt(flatPosition, targetRoot.Position)
		elseif orbitActive then
			orbitAngle += deltaTime * 1.8
			local offset = Vector3.new(math.cos(orbitAngle) * orbitRadius, orbitHeight, math.sin(orbitAngle) * orbitRadius)
			local orbitPosition = targetRoot.Position + offset
			local desiredCFrame = CFrame.lookAt(orbitPosition, targetRoot.Position)
			local smoothness = 12
			local smoothingAlpha = 1 - math.exp(-smoothness * deltaTime)
			localRoot.CFrame = localRoot.CFrame:Lerp(desiredCFrame, smoothingAlpha)
		end
	end)
	
	trakButton.Activated:Connect(function()
		if trakActive then
			stopModes()
			return
		end
		if validateSelection() then
			followActive = false
			orbitActive = false
			setOrbitCollision(false)
			trakActive = true
			trakButton.Text = "Остановить"
			followButton.Text = "Преследовать"
			orbitButton.Text = "Орбит"
	
			local distance = 2
			task.spawn(function()
				while trakActive do
					if not validateSelection() then
						stopModes()
						break
					end
					local _, _, localRoot = getLocalCharacter()
					local targetRoot = getRoot(selectedPlayer)
					if not localRoot or not targetRoot then
						stopModes()
						break
					end
	
					local targetPosition = targetRoot.Position - targetRoot.CFrame.LookVector * distance
					localRoot.CFrame = CFrame.lookAt(targetPosition, targetRoot.Position)
					distance = distance == 3 and 1 or 3
					task.wait(0.2)
				end
			end)
	end
	
	setChosenText()
	rebuildPlayerList()
	end)
end;
