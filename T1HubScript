	local spectatorPlayers = {}
	local spectatorIndex = 0
	local spectatorTarget = nil
	
	local clickTeleportEnabled = false
	local defaultButtonTexts = {
		copy = copyJobIdButton.Text,
		clickTeleport = clickTeleportButton.Text,
	}
	
	local function showButtonStatus(button, text, duration)
		button.Text = text
		task.delay(duration or 3, function()
			if button and button.Parent then
				if button == copyJobIdButton then
					button.Text = defaultButtonTexts.copy
				elseif button == clickTeleportButton then
					button.Text = clickTeleportEnabled and "клик телепорт ON" or defaultButtonTexts.clickTeleport
				end
			end
		end)
	end
	
	local function getCharacterRoot()
		local character = player.Character
		if not character or not character.Parent then
			return nil, nil
		end
		local root = character:FindFirstChild("HumanoidRootPart")
		if not root or not root:IsA("BasePart") then
			return nil, nil
		end
		return character, root
	end
	
	local function teleportToMouse(screenPosition)
		local character, root = getCharacterRoot()
		if not character or not root then
			showButtonStatus(clickTeleportButton, "Персонаж не готов", 2)
			return
		end
	
		local camera = workspace.CurrentCamera
		if not camera then
			showButtonStatus(clickTeleportButton, "Камера недоступна", 2)
			return
		end
	
		local inset = GuiService:GetGuiInset()
		local ray = camera:ViewportPointToRay(screenPosition.X - inset.X, screenPosition.Y - inset.Y)
		local raycastParams = RaycastParams.new()
		raycastParams.FilterType = Enum.RaycastFilterType.Exclude
		raycastParams.FilterDescendantsInstances = { character }
		local result = workspace:Raycast(ray.Origin, ray.Direction * 2000, raycastParams)
		if not result then
			showButtonStatus(clickTeleportButton, "Место не найдено", 2)
			return
		end
	
		local currentPivot = character:GetPivot()
		local lift = math.max(root.Size.Y * 0.5, 2)
		character:PivotTo(CFrame.new(result.Position + Vector3.new(0, lift, 0)) * currentPivot.Rotation)
	end
	
	local function setClickTeleport(enabled)
		clickTeleportEnabled = enabled
		clickTeleportButton:SetAttribute("Toggled", enabled)
		clickTeleportButton.Text = enabled and "клик телепорт ON" or defaultButtonTexts.clickTeleport
	end
	
	local lastClickTeleportToggle = 0
	local function toggleClickTeleport()
		local now = os.clock()
		if now - lastClickTeleportToggle < 0.1 then
			return
		end
		lastClickTeleportToggle = now
		setClickTeleport(not clickTeleportEnabled)
	end
	
	clickTeleportButton.Activated:Connect(toggleClickTeleport)
	clickTeleportButton.MouseButton1Click:Connect(toggleClickTeleport)
	
	local function getSpectatorPlayers()
		local availablePlayers = {}
		for _, otherPlayer in Players:GetPlayers() do
			if otherPlayer ~= player then
				table.insert(availablePlayers, otherPlayer)
			end
		end
		table.sort(availablePlayers, function(firstPlayer, secondPlayer)
			return string.lower(firstPlayer.Name) < string.lower(secondPlayer.Name)
		end)
		return availablePlayers
	end
	
	local function setSpectatorCamera(targetPlayer)
		local camera = workspace.CurrentCamera
		if not camera then
			return false
		end
	
		local character = targetPlayer and targetPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			return false
		end
	
		camera.CameraType = Enum.CameraType.Custom
		camera.CameraSubject = humanoid
		spectatorTarget = targetPlayer
		playerNameLabel.Text = targetPlayer.DisplayName .. " (" .. targetPlayer.Name .. ")"
		return true
	end
	
	local function refreshSpectatorPlayers()
		spectatorPlayers = getSpectatorPlayers()
		if #spectatorPlayers == 0 then
			spectatorIndex = 0
			playerNameLabel.Text = "Нет других игроков"
			return false
		end
	
		if spectatorTarget then
			for index, targetPlayer in spectatorPlayers do
				if targetPlayer == spectatorTarget then
					spectatorIndex = index
					break
				end
			end
		end
	
		if spectatorIndex < 1 or spectatorIndex > #spectatorPlayers then
			spectatorIndex = 1
		end
		return true
	end
	
	local function spectateAtIndex(index)
		if not spectatorEnabled then
			return
		end
		if not refreshSpectatorPlayers() then
			return
		end
	
		spectatorIndex = ((index - 1) % #spectatorPlayers) + 1
		local targetPlayer = spectatorPlayers[spectatorIndex]
		if not setSpectatorCamera(targetPlayer) then
			playerNameLabel.Text = targetPlayer.DisplayName .. " (ожидание персонажа)"
		end
	end
	
	local function positionSpectatorFrameAtBottom()
		local horizontalScale = specFrame.Position.X.Scale
		local horizontalOffset = specFrame.Position.X.Offset
		local bottomMargin = 48
		local halfHeight = specFrame.AbsoluteSize.Y * 0.5
		if halfHeight <= 0 then
			halfHeight = specFrame.Size.Y.Offset * 0.5
		end
	
		specFrame.AnchorPoint = Vector2.new(0, 0.5)
		specFrame.Position = UDim2.new(horizontalScale, horizontalOffset, 1, -(halfHeight + bottomMargin))
	end
	
	local function startSpectating()
		if spectatorEnabled then
			return
		end
	
		spectatorEnabled = true
		positionSpectatorFrameAtBottom()
		specFrame.Visible = true
		spectatorTarget = nil
		spectatorIndex = 1
		spectateAtIndex(spectatorIndex)
	end
	
	local function stopSpectating()
		if not spectatorEnabled then
			specFrame.Visible = false
			return
		end
	
		spectatorEnabled = false
		spectatorTarget = nil
		spectatorPlayers = {}
		spectatorIndex = 0
		specFrame.Visible = false
	
		local camera = workspace.CurrentCamera
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if camera then
			camera.CameraType = Enum.CameraType.Custom
			if humanoid then
				camera.CameraSubject = humanoid
			end
		end
	end
	
	specPlayersButton.Activated:Connect(startSpectating)
	nextPlayerButton.Activated:Connect(function()
		spectateAtIndex(spectatorIndex + 1)
	end)
	previousPlayerButton.Activated:Connect(function()
		spectateAtIndex(spectatorIndex - 1)
	end)
	exitSpectatorButton.Activated:Connect(stopSpectating)
	
	local function watchSpectatorCharacter(targetPlayer)
		targetPlayer.CharacterAdded:Connect(function()
			if spectatorEnabled and spectatorTarget == targetPlayer then
				task.defer(function()
					if spectatorEnabled and spectatorTarget == targetPlayer then
						setSpectatorCamera(targetPlayer)
					end
				end)
			end
		end)
	end
	
	for _, otherPlayer in Players:GetPlayers() do
		if otherPlayer ~= player then
			watchSpectatorCharacter(otherPlayer)
		end
	end
	
	Players.PlayerAdded:Connect(function(otherPlayer)
		if otherPlayer ~= player then
			watchSpectatorCharacter(otherPlayer)
		end
		if spectatorEnabled then
			spectatorPlayers = getSpectatorPlayers()
		end
	end)
	
	Players.PlayerRemoving:Connect(function(leavingPlayer)
		if not spectatorEnabled then
			return
		end
		if leavingPlayer == spectatorTarget then
			spectatorTarget = nil
			task.defer(function()
				if spectatorEnabled then
					spectateAtIndex(spectatorIndex)
				end
			end)
		else
			spectatorPlayers = getSpectatorPlayers()
		end
	end)
	
	player.CharacterAdded:Connect(function(character)
		if spectatorEnabled and spectatorTarget == player then
			task.defer(function()
				local humanoid = character:WaitForChild("Humanoid", 5)
				if humanoid and spectatorEnabled then
					local camera = workspace.CurrentCamera
					if camera then
						camera.CameraSubject = humanoid
					end
				end
			end)
		end
	end)
	
	UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
		if not clickTeleportEnabled then
			return
		end
	
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			local mouseLocation = UserInputService:GetMouseLocation()
			local buttonPosition = clickTeleportButton.AbsolutePosition + GuiService:GetGuiInset()
			local buttonSize = clickTeleportButton.AbsoluteSize
			local insideButton = mouseLocation.X >= buttonPosition.X
				and mouseLocation.X <= buttonPosition.X + buttonSize.X
				and mouseLocation.Y >= buttonPosition.Y
				and mouseLocation.Y <= buttonPosition.Y + buttonSize.Y
			if insideButton then
				return
			end
			teleportToMouse(mouseLocation)
		elseif input.UserInputType == Enum.UserInputType.Touch then
			teleportToMouse(input.Position)
		end
	end)
	
	local function teleportSafely(callback, errorText)
		local ok, err = pcall(callback)
		if not ok then
			warn("[ServerToolsScript] " .. errorText .. ": " .. tostring(err))
			return false
		end
		return true
	end
	
	rejoinButton.Activated:Connect(function()
		teleportSafely(function()
			TeleportService:Teleport(game.PlaceId, player)
		end, "Не удалось выполнить rejoin")
	end)
	
	local function tryCopyToClipboard(text)
		local copied = false
		local ok = pcall(function()
			if typeof(setclipboard) == "function" then
				setclipboard(text)
				copied = true
			end
		end)
		return ok and copied
	end
	
