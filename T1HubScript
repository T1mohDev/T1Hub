		end
	end
	
	local function connectTextBox(box)
		if box:GetAttribute("AnimConnected") then
			return
		end
		box:SetAttribute("AnimConnected", true)
	
		box.MouseEnter:Connect(function()
			if not box:IsFocused() then
				tweenColor(box, DARK_PALETTE.panelAlt, HOVER_INFO)
			end
		end)
	
		box.MouseLeave:Connect(function()
			if not box:IsFocused() then
