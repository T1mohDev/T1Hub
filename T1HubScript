				createPlayerButton(targetPlayer)
			end
		end
		playerList.CanvasSize = UDim2.new(0, 0, 0, #visiblePlayers * 32)
		print("[PlayerActionsScript] Server players: " .. #Players:GetPlayers() .. "; list entries: " .. #visiblePlayers .. "; local player: " .. localPlayer.Name)
		for index, targetPlayer in ipairs(visiblePlayers) do
			print("[PlayerActionsScript] Entry " .. index .. ": " .. targetPlayer.Name)
		end
		if selectedPlayer and not selectedPlayer.Parent then
			selectedPlayer = nil
			setChosenText()
			stopModes()
		end
	end
	
	local function connectPlayer(targetPlayer)
		playerConnections[targetPlayer] = targetPlayer.CharacterAdded:Connect(function()
			if targetPlayer == selectedPlayer then
				stopModes()
			end
		end)
	end
	
	local function disconnectPlayer(targetPlayer)
		local connection = playerConnections[targetPlayer]
		if connection then
			connection:Disconnect()
			playerConnections[targetPlayer] = nil
		end
		if selectedPlayer == targetPlayer then
			selectedPlayer = nil
			setChosenText()
			stopModes()
		end
