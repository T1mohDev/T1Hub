			for k in pairs(_roles) do _roles[k] = nil end
			for k in pairs(_dead) do _dead[k] = nil end
			for _, child in ipairs(espFolder:GetChildren()) do child:Destroy() end
			for k in pairs(_G.RE.highlights) do _G.RE.highlights[k] = nil end
			task.wait(1)
			refresh()
