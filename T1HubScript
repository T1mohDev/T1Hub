			scale.Name = "HoverScale"
			scale.Parent = obj
		end
		return scale
	end
	
	
	
	local function connectButton(button)
		if button:GetAttribute("AnimConnected") then
			return
		end
		button:SetAttribute("AnimConnected", true)
	
		button.MouseButton1Down:Connect(function()
			getScale(button).Scale = SCALE_PRESS
		end)
	
		button.MouseButton1Up:Connect(function()
			getScale(button).Scale = 1
		end)
	
		
	end
	
	local function connectObject(obj)
		if obj:IsA("TextButton") or obj:IsA("ImageButton") then
