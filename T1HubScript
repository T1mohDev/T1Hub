					h = getHighlight(p)
					h.Adornee = char
					h.FillColor = _G.RE.COLORS[role]
					h.OutlineColor = _G.RE.COLORS[role]
					h.Enabled = true
				else
					if h then h.Enabled = false end
				end
			end
		end)
	
		Players.PlayerRemoving:Connect(function(p)
			local h = highlights[p]
			if h then h:Destroy(); highlights[p] = nil end
			_roles[p] = nil
			_dead[p] = nil
		end)
	
		task.spawn(function()
			task.wait(2)
			refresh()
			while true do
				task.wait(2)
				refresh()
			end
		end)
	
		LP.CharacterAdded:Connect(function() task.wait(1) refresh() end)
	end
	
	-- ===================== TOGGLE =====================
	local NAME = btn.Text:gsub("[▶II%s]", "")  -- сохраняем название без стрелки
	
	btn.MouseButton1Click:Connect(function()
		_G.RE.enabled.Murderer = not _G.RE.enabled.Murderer
		if _G.RE.enabled.Murderer then
			btn.Text = NAME .. " II"
		else
			btn.Text = NAME .. " ▶"
		end
	end)
end;
