	-- === ВСТАВИТЬ В LocalScript ВНУТРИ TextButton "Шериф" ===
	local btn = script.Parent
	if not btn or not btn:IsA("TextButton") then
		return warn("[ESP] Скрипт должен быть LocalScript внутри TextButton")
	end
	
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local LocalPlayer = Players.LocalPlayer
	
	local ENABLED = false
	local highlights = {}
	local COLOR = Color3.fromRGB(0, 100, 255)
	
	-- Ищем Gun у игрока
	local function isSheriff(player)
		if not player.Character then return false end
		local bp = player:FindFirstChild("Backpack")
		return player.Character:FindFirstChild("Gun") or (bp and bp:FindFirstChild("Gun"))
	end
	
	-- Создать / обновить Highlight
	local function apply(player)
		if player == LocalPlayer or not player.Character then return end
	
		local h = highlights[player]
		if not h or h.Parent ~= player.Character then
			if h then h:Destroy() end
			h = Instance.new("Highlight")
			h.Name = "ESP_Sheriff_HL"
			h.FillTransparency = 0.85        -- слабая заливка
			h.OutlineTransparency = 0        -- чёткая обводка
			h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			h.FillColor = COLOR
			h.OutlineColor = COLOR
			h.Parent = player.Character
			highlights[player] = h
		end
	
		h.Enabled = ENABLED and isSheriff(player)
	end
	
	-- Клик по кнопке — вкл/выкл
	btn.MouseButton1Click:Connect(function()
		ENABLED = not ENABLED
