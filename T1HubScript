local function C_107()
local script = G2L["107"];
	local Players = game:GetService("Players")
	
	local player = Players.LocalPlayer
	local frame = script.Parent
	
	-- в Frame3 есть и TextLabel и TextBox с одинаковыми именами,
	-- поэтому ищем именно TextBox
	local function findTextBox(name)
		for _, child in frame:GetChildren() do
			if child:IsA("TextBox") and child.Name == name then
				return child
			end
		end
		return nil
	end
	
	local function getHumanoid()
		local character = player.Character
		return character and character:FindFirstChildOfClass("Humanoid")
	end
	
	local speedBox = findTextBox("Speed")
	local jumpBox = findTextBox("Jump")
	local gravityBox = findTextBox("Gravity")
	
	-- последние применённые значения — чтобы восстановить их после респавна
	local lastSpeed = 16
	local lastJump = 50
	local lastGravity = 196.2
	
	local function applySpeed(value)
		lastSpeed = value
		local humanoid = getHumanoid()
		if humanoid then
			humanoid.WalkSpeed = value
		end
	end
	
	local function applyJump(value)
		lastJump = value
		local humanoid = getHumanoid()
		if humanoid then
			humanoid.UseJumpPower = true
			humanoid.JumpPower = value
		end
	end
	
	local function applyGravity(value)
		lastGravity = value
		workspace.Gravity = value
	end
	
	-- применение значения из поля при нажатии Enter
	local function connectBox(box, apply, min, max)
		if not box then
			return
		end
		box.FocusLost:Connect(function(enterPressed)
			if not enterPressed then
				return
			end
			local value = tonumber(box.Text)
			if value and value >= min then
				apply(math.min(value, max))
			end
		end)
	end
	
	connectBox(speedBox, applySpeed, 1, 1000)
	connectBox(jumpBox, applyJump, 1, 1000)
	connectBox(gravityBox, applyGravity, 0, 1000)
	
	-- быстрые кнопки: применяют значение и записывают его в поле
	local function connectQuickButton(buttonName, box, apply, value)
		local button = frame:FindFirstChild(buttonName)
		if not button then
			return
		end
		button.MouseButton1Click:Connect(function()
			apply(value)
			if box then
				box.Text = tostring(value)
			end
		end)
	end
	
	connectQuickButton("Speed20", speedBox, applySpeed, 20)
	connectQuickButton("Jump150", jumpBox, applyJump, 150)
	connectQuickButton("Gravity2", gravityBox, applyGravity, 2)
	connectQuickButton("Gravity196", gravityBox, applyGravity, 196.2)
	
	-- после респавна восстанавливаем последние значения
	player.CharacterAdded:Connect(function()
		task.wait(0.5)
		applySpeed(lastSpeed)
		applyJump(lastJump)
		applyGravity(lastGravity)
	end)
end;
