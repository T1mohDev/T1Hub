                if _saved[obj] == nil then
                    _saved[obj] = {Material = obj.Material, Reflectance = obj.Reflectance, CastShadow = obj.CastShadow}
                end
                obj.Material = Enum.Material.Plastic
                obj.Reflectance = 0
                obj.CastShadow = false
            else
