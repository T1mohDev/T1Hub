local function C_20()
local script = G2L["20"];
	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")
	
	local row = script.Parent
	local track = row:WaitForChild("Track")
	local knob = track:WaitForChild("Knob")
	
	-- Пока тянешь ползунок — шарик плавно увеличивается.
	local knobScale = Instance.new("UIScale")
	knobScale.Scale = 1
	knobScale.Parent = knob
	
	local GROW_SCALE = 1.15
	local function growTo(target)
		knobScale.Scale = target
	end
	
	local MIN_SPEED = 0
	local MAX_SPEED = 150
	local value = 16
	
	local GREEN = "#4CD04B"
	
	local player = Players.LocalPlayer
	local dragging = false
	local baseKnobSize = 14 -- размер шарика без увеличения (UIScale меняет AbsoluteSize)
	
	local function applySpeed()
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.WalkSpeed = value
		end
	end
	
	local function updateLabel()
		row.Text = (" SPEED: <font color='%s'>%d</font>"):format(GREEN, value)
	end
	
	local function setKnobFraction(fraction)
		local half = baseKnobSize / 2
		local span = track.AbsoluteSize.X - baseKnobSize
		knob.Position = UDim2.new(0, half + fraction * span, 0.5, 0)
	end
	
	local function setFromMouseX(mouseX)
		local half = baseKnobSize / 2
		local span = track.AbsoluteSize.X - baseKnobSize
		if span <= 0 then
			return
		end
		local fraction = math.clamp((mouseX - track.AbsolutePosition.X - half) / span, 0, 1)
		value = math.floor(MIN_SPEED + fraction * (MAX_SPEED - MIN_SPEED) + 0.5)
		setKnobFraction(fraction)
		updateLabel()
		applySpeed()
	end
	
	local function onInputBegan(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			growTo(GROW_SCALE)
			setFromMouseX(input.Position.X)
		end
	end
	
	track.InputBegan:Connect(onInputBegan)
	knob.InputBegan:Connect(onInputBegan)
	
	UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			setFromMouseX(input.Position.X)
		end
	end)
	
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
			growTo(1)
		end
	end)
	
	-- Ползунок стартует на значении 16 (как и стандартная WalkSpeed).
	-- Ждём, пока GUI посчитает размеры, иначе AbsoluteSize == 0.
	task.spawn(function()
		while track.AbsoluteSize.X <= 0 do
			task.wait()
		end
		baseKnobSize = knob.AbsoluteSize.X
		setKnobFraction((value - MIN_SPEED) / (MAX_SPEED - MIN_SPEED))
		updateLabel()
		print("[SpeedSlider] init, speed =", value)
	end)
	
	-- После респавна скорость применяется заново.
	player.CharacterAdded:Connect(function(character)
		local humanoid = character:WaitForChild("Humanoid", 5)
		if humanoid then
			task.wait(0.2)
			humanoid.WalkSpeed = value
		end
	end)
end;
